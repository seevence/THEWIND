ideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"4e17e1b0-8220-4b8b-92ce-ca5755e1ed4a","HeadCount":0,"JobAdId":230905549,"PostDateInt":1779244071000,"PostDate":"2026-05-20T10:27:51","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"汽车座舱多模态大模型资深算法工程师(J17640)","OrgId":2404678,"Org":"电子算法部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["浙江省·杭州市"],"Salary":"面议","Duty":"我们正在寻找一位在多模态深度学习基础模型领域有深厚造诣的工程师：你将负责为下一代智能座舱构建统一、高效、可扩展的多模态感知与理解核心，将语音、视觉等异构信号融合为机器可理解的智能，你的工作将是实现座舱真正“情境感知”与“主动智能”的技术基石，直接定义产品的核心竞争力。\n1.负责研究和设计面向汽车座舱场景的下一代基于多模态（包括但不限于语音信号、车内外视觉、生物信号、车辆CAN信号等）网络架构的核心算法研发及量产落地；\n2.与语音识别、计算机视觉、上下游团队紧密协作，将模型输出的统一表征高效赋能给多个上层应用任务（如多模语音交互、情感计算、场景化服务推荐等）；\n3.核心算法的研发，如自监督/半监督多模态继续预训练、微调（LoRA/QLoRA）、强化学习、以海量车载数据驱动模型进化等。","Require":"1.国内外顶尖高校计算机、人工智能、电子工程等相关专业硕士及以上学历，并具备3年以上深度学习算法研发经验；\n2.精通深度学习，尤其是Transformer、多模态学习、跨模态对齐、大模型微调、知识蒸馏等有深刻理解和实战经验；\n3.精通Python，熟练掌握PyTorch，具备优秀的C++编程能力和模型部署优化经验；\n4.拥有极强的技术自驱力、系统性解决问题的思维以及优秀的跨团队沟通能力；\n5.在CVPR/ICCV/ECCV、NeurIPS/ICML、ACL/ICASSP等顶会发表论文者或行业开源数据集刷榜名次靠前者优先；\n6.具备智能座舱领域多模态模型训练和业务开发相关经验者优先。","ClassificationOne":"三电算法类","ClassificationTwo":"杭州市","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"硕士研究生","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward