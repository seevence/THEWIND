主流AI问答的信息建设与效果跟踪，管理SEO、GEO合作和搜索承接。\n四、线索与经营管理\n1.\t联动销售及线索运营统一有效线索、归因和分发口径，跟踪联系、到店及试驾反馈，推动承接改进。\n2.\t对有效线索量、获客成本及预算执行负责，承担阶段A3兴趣人群以及自然到店线索目标，以经营看板和复盘优化渠道投入。","Require":"1.\t本科及以上学历，10年以上工作经验，具备团队管理及多渠道获客统筹经验。\n2.\t熟悉主流平台投放、媒体采购与预算管理，能依据人群、素材和转化效果调整策略。\n3.\t具备搜索营销与SEO经验，理解内容平台搜索和AI问答机制，有GEO实操经验者优先。\n4.\t具备新媒体直播获客经验，理解内容、投流、直播与线索承接的协作关系。","ClassificationOne":"营销服类","ClassificationTwo":"杭州市","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-10-30T13:17:58","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"98040d2a-f793-442d-8eaa-467b7c2e3764","HeadCount":0,"JobAdId":230950799,"PostDateInt":1793151956000,"PostDate":"2026-10-28T09:45:56","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"内容营销高级经理（平台运营）(J18467)","OrgId":3586001,"Org":"媒介二部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocN