eliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"7529c775-4745-494a-be8b-07a53607685e","HeadCount":0,"JobAdId":190841426,"PostDateInt":1784610798000,"PostDate":"2026-07-21T13:13:18","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"单板工艺工程师(J12611)","OrgId":700405118,"Org":"工业自动化BG","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"1、单板工艺设计：负责项目开发PCBA设计的DFX评审、PCB工艺可行性评审，EQ问题的确认；\n2、工艺技术研究与创新：参与竞品分析，行业调研，提炼行业具有竞争力的技术，规划新技术的预研；针对新工艺、新技术、新材料、新工具进行识别和充分评估，并结合行业发展趋势及友商动态，给出验证和解决方案，\n3、单板工艺技术支持：分析解决项目试制、过程中的PCBA相关生产和SMT工艺问题等，确保顺利量产；分析解决售后相关PCBA单板问题，升级设计、生产、测试体系进行改善；\n4、构建平台：承担PCBA单板工艺业务及技术平台建设、规范设计、建立工艺知识库等 ;\n5、文件归档：根据研发流程的要求制定提供相关产品文档资料、产品数据，确保质量的齐套性、准确性 ;","Require":"1、熟悉各类电子元器件和电子行业的相关IPC标准 ;\n2、熟悉PCB、PCBA的生产制造工艺，具备丰富的解决生产制造工艺问题经验 ;\n3、熟悉电子元器件应用工艺、工艺辅料应用要求 ;\n4、能独立完成PCBA相关的新工艺、新材料、新技术的整体完整研究；\n5、熟练掌握PCB设计工艺要求，并参与PCB的DFM评审;\n6、能独立完成单板总体工艺方案设计与验证；能独立设计PCB电子装联工艺方案；解决电子装联过程中出现的问题和难点 ;\n7、本科及以上学历，电子应用等相关专业，具备UPS电源、变频器、伺服等相关产品单板工艺开发与失效分析工作经验;","ClassificationOne":"研发技术类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-07-21T13:13:18","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"10fbef8e-9391-45cb-84df-2061ae23cfe9","HeadCount":0,"JobAdId":190834811,"PostDateInt":1782271565000,"PostDate":"2026-06-24T11:26:05","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"试制工程师（苏州）(J12583)","OrgId":700405148,"Org":"技术与研发中心","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·苏州市"],"Salary":"面议","Duty":"1、负责担任中试代表，代表中试领域参与产品开发各阶段的技术评审，保证技术评审质量制定产品制造策略，对项目转产交付(导入进度，质量，制造成本，产能)负责； 参与项目过程方案评审，对可装配性、可测试性、可靠性、可维修性、可加工性进行全面评审；； \n2、负责组织新产品样机和小批量试制，主导工程样机制作，发掘样机存在的DFX风险点并推进改善，输出工艺流程（Flowchart）和关键工艺指引；\n3、负责编写生产测试方案，验收生产测试工装，主导解决生产测试领域问题； \n4、主导试产全过程，协调资源确保达成试产目标，保证质量及交付完成，包含产前准备，异常处理，试产总结； \n5、负责跟进试产问题点处理进度，及不良品失效分析，指导操作人员完成不良品维修，并统筹回归验证至闭环（PDCA)； \n6、协助对中试部试制工作整体规划。","Require":"1、本科及以上学历，电子电气相关专业； \n2、熟悉模拟电路、数字电路、电气原理图等相关电力电子知识，有参与光储，网络能源，UPS电源，变频器、伺服、PLC等相关工控类关产品3年以上工作经验； \n3、能熟练运用电烙铁、万用表、示波器等常用电子维修工具； \n4、熟练操作各种办公软件，能懂CAD,Pro/E软件更佳，\n5、逻辑思维较好，具备快速响应现场突发异常并提供解决方案的能力，并具有良好沟通协调能力和良好的团队协助精神。","ClassificationOne":"研发技术类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-24T11:26:05","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"0009d241-d3d9-4fef-842a-90da9c956003","HeadCount":0,"JobAdId":190834654,"PostDateInt":1782207842000,"PostDate":"2026-06-23T17:44:02","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"硬件测试工程师(J12579)","OrgId":700405121,"Org":"新能源动力BG","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市·光明区"],"Salary":"面议","Duty":"1、负责电机控制器多合一产品（集成MCU、DCAC、DCDC、OBC、PDU、热管理模块等）的硬件白盒测试，主导主导白盒、黑盒及极限工况测试，保障产品在极端环境下的可靠性、EMC及安规性能\n2、控制器硬件测试需求分析，制定覆盖功能、性能、耐久、安规、EMC的测试策略与计划制定测试方案，搭建测试平台，撰写测试报告、DFMEA测试案例库、失效分析知识库；\n3、主导编写高压功率模块（IGBT/SiC）、开关电源、采样链路、驱动电路等核心电路的白盒测试方案（如双脉冲、热阻、短路、极限应力）\n4、按照测试方案和测试用例执行测试任务时，发现产品缺陷，提交测试问题，推动项目组解决测试问题，验证测试问题，归档测试报告，严格把关，保证产品质量。\n5、协助研发人员进行测试问题的重现和解决。\n6、协助市场问题分析，对市场问题进行分析、定位和验证。\n7、参与研究硬件白盒测试标准、部门内部技术平台的建设；\n8、参与测试规范和测试平台的建设。","Require":"1、本科及以上学历，电气工程、电力电子、自动化、电子信息工程等相关专业；\n2、新能源汽车电控或高压电源类硬件测试经验；（三年以上硬件设计经验）\n3、熟练掌握电路理论知识，如模拟电电路、数字电路等。熟悉常用的电子元器件。能读懂电路原理图；\n4、有电动汽车控制器或同类产品（变频器、伺服驱动器、UPS、车载电源OBC等）经验优先考虑。\n5、熟悉使用示波器、信号发生器、热成像仪、可编程电子负载、可编程电源等测试仪器； \n6、必备工作素质：关系建立、团队合作。","ClassificationOne":"研发技术类","ClassificationT