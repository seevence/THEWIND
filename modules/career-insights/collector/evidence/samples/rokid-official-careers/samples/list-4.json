:null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-26T11:12:50","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"513eaaf4-723b-4c01-87f0-928d2e5f92d0","HeadCount":0,"JobAdId":151205783,"PostDateInt":1782099644000,"PostDate":"2026-06-22T11:40:44","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"供应商质量管理工程师","OrgId":1628043,"Org":"质量管理","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["浙江省·杭州市"],"Salary":"面议","Duty":"岗位职责\n1.负责AR眼镜项目供应商的质量管理与改进，确保机电电子料来料质量符合要求；\n2.参与新供应商审核与导入，评估制造能力与质量体系；\n3.推动供应商完成样品验证、量产导入及PPAP文件提交；\n4.主导供应商质量问题分析与改善（8D、5Why等）；\n5.跟踪光学、结构、电子类零部件的制程质量与可靠性测试；\n6.建立并维护供应商绩效指标，推动持续改进。","Require":"任职要求\n1.本科及以上学历，机械、电子、光学或质量工程相关专业；\n2.具有5年以上SQE经验，有AR/VR或智能硬件行业电子料SQE背景优先；\n3.熟悉质量工具与体系（APQP、PPAP、FMEA、8D、ISO9001等）；\n4.熟悉电子件制程及可靠性测试；\n5.具备良好的沟通协调能力与问题分析能力。","ClassificationOne":"产研类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-22T11:40:44","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"69740ff7-1df7-4ef4-b3a2-c7ff8e48282b","HeadCount":0,"JobAdId":151205048,"PostDateInt":1781696005000,"PostDate":"2026-06-17T19:33:25","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"光学镜头结构设计工程师","OrgId":1628040,"Org":"结构","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["上海市"],"Salary":"面议","Duty":"岗位职责\n1、负责光学镜头结构方案设计与开发，涵盖结构方案评估、三维建模、详细结构设计，输出完整设计方案，保障镜头结构可行性、稳定性及量产性。\n2、主导镜头项目全生命周期开发，包含前期立项评估、结构DFM可制造性评审、光学结构匹配分析、公差堆叠分析、风险预判，提前规避组装干涉、偏心、倾斜、虚焦、解析力不良、温漂失效等结构类问题。\n3、完成镜头结构详细设计工作，合理匹配光学镜片、光阑、Sensor组装关系，优化整机装配结构与尺寸布局。\n4、输出全套量产图纸与技术文件，包含3D结构图、2D工程图、BOM清单、公差标注、装配工艺规范、检验标准，明确零件加工、组装、点胶、固化、调试技术要求。\n5、负责镜头零部件外协跟进与样品验证，对接模具、机加工、注塑、五金供应商，跟进零件打样、试产、尺寸验证、整改优化，把控零件精度与交付质量。\n6、主导镜头样机装配、调试、测试与验证，配合光学、工艺、品质团队完成MTF、畸变、色差、焦距、温漂、可靠性测试（高低温、湿热、振动、跌落），针对测试失效问题定位结构根因并落地优化方案。\n7、解决试产、量产阶段结构异常与组装不良，如偏心不良、组装卡顿、压伤镜片、虚焦、跑焦、结构松动、点胶溢胶、脱胶等问题，输出整改报告与标准化改善方案，提升良率与量产稳定性。\n8、沉淀镜头结构设计标准、公差体系、材料选型规范、可靠性设计准则，迭代设计数据库，优化产品成本、体积与性能。","Require":"任职要求\n1、本科及以上学历，机械设计、精密机械、光学工程、仪器科学与技术等相关专业，5年及以上光学镜头结构设计独立开发经验。\n2、熟练使用Creo/ProE三维设计软件，精通2D工程图绘制、GD&T公差设计、公差堆叠分析，具备扎实的精密结构设计功底。\n3、熟悉光学镜头基本原理与结构形式，精通定焦、广角、微距、变焦镜头结构设计逻辑，熟悉镜片排布、光机结构、对焦结构、VCM马达结构匹配原理。\n4、熟悉镜头常用材料特性，包括PC、ABS、LCP、不锈钢、黄铜、铝件等材质，掌握注塑零件、精密车削零件的加工工艺、公差能力与结构设计适配要求。\n5、熟悉镜头组装工艺、点胶固化、校准调试流程，精通各类镜头常见结构不良问题分析与整改，具备独立解决量产结构问题的能力。\n6、熟悉镜头可靠性设计标准，掌握高低温、湿热、振动、跌落、温漂等可靠性测试要求，能针对性做结构防失效、防变形、防松动优化设计。\n7、具备良好的项目推进能力、沟通协调能力，可对接内外部团队与供应商，抗压能力强，能跟进项目节点落地。\n8、工作严谨细致，具备精密产品设计思维、风险预判意识和持续改善能力，对镜头精度、成像稳定性、量产良率有严格把控意识。\n专项加分条件\n1、有车载镜头、高像素手机镜头、安防变焦镜头、工业精密镜头独立项目开发经验者优先；\n2、熟悉光学设计软件（Zemax、CodeV），可配合光学方案联动优化结构、匹配光路、优化公差者优先；\n3、熟悉镜头自动化组装工艺、精密点胶工艺、无尘制程管控经验者优先；\n4、有镜头结构降本、小型化设计、超薄镜头、高倍率变焦结构优化成功案例者优先。","ClassificationOne":"产研类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-17T19:33:25","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeat