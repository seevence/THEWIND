、市场、财务、供应链等角色配合。\n加分项\n经历过0-1销售体系搭建或初创公司高速增长阶段。\n了解助听器行业渠道模式（如验配中心、医院、线上、药店等）。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"8年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-23T12:54:41","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"d89e30df-4cbb-45cb-b77b-429688eb6faa","HeadCount":0,"JobAdId":230913464,"PostDateInt":1781670574000,"PostDate":"2026-06-17T12:29:34","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"市场GTM专员（中级/高级）(J16824)","OrgId":3416165,"Org":"UIM","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["上海市·嘉定区"],"Salary":"40K-60K 元/月","Duty":"产品上市全周期操盘：负责公司产品国内上市和退市的全流程操盘工作，制定和推动营销团队各部门的执行计划，包括市场调研、产品定位、定价策略、渠道适配、临床学术推广等，确保新品快速切入目标市场、实现销量突破；监控成熟产品市场表现，识别新机会，调整策略，确保市场份额提升。\n市场洞察与数据驱动：深度洞察国内医疗器械行业趋势、临床需求变化、竞品策略（产品定位、渠道打法、学术推广），为公司产品研发、战略调整提供决策支持；搭建GTM数据