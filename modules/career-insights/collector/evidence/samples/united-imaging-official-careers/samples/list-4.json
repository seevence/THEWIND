-15T16:59:02","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"cfb2bc4f-fad9-44fe-9c96-b026a1f93b53","HeadCount":0,"JobAdId":230920588,"PostDateInt":1784104128000,"PostDate":"2026-07-15T16:28:48","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"芯片主计划专员（调度）(J18516)","OrgId":3416165,"Org":"UIM","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["上海市·嘉定区"],"Salary":"15K-20K 元/月","Duty":"1.下单调度管理‌\n统筹晶圆投片、封装测试等全流程订单下达，对接外部晶圆厂、封测厂确认排期。\n跟踪急单、异常订单进度，协调资源保障交付，处理生产环节突发问题。\n2‌.物料计划管控‌\n基于销售预测与主生产计划，通过ERP系统生成精准物料需求计划（MRP）。\n制定安全库存策略，管控关键元器件供应，降低呆滞物料占比，优化库存周转效率。\n3‌.跨部门协同与数据管理‌\n联动销售、研发、采购部门推进产销协同，搭建物料全生命周期基础数据库。\n定期汇总生产、库存数据，输出分析报表，为管理层提供供应链决策支持。\n\n熟悉芯片生产周期特性，提前识别晶圆、封测环节的供应风险并制定预案。\n物料追溯需精确到炉次号、纯度指标，满足半导体行业严苛的品质管控标准。","Require":"3-5年芯片计划调度工作经验，FABLESS芯片设计公司工作经验为佳","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescripti