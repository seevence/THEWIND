us":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-28T09:23:08","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"aea841b6-384d-4d68-a9b6-b8d776bb8aa3","HeadCount":0,"JobAdId":561318319,"PostDateInt":1793150438000,"PostDate":"2026-10-28T09:20:38","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"安全员","OrgId":2670870,"Org":"前瞻事业部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江西省·南昌市"],"Salary":"面议","Duty":"1、日常监控与状态管理\n-实时监控多台无人物流车云端运行画面、车辆状态、定位、传感器、报警告警信息，及时识别道路障碍、行人、车辆闯入、设备故障等各类安全风险。\n-接收现场网格员上报的现场路况、道路施工、障碍物、现场突发状况，同步更新后台任务，调度车辆绕行、暂停作业。\n2、异常与紧急接管\n-发生车辆异常、紧急险情时，执行远程接管、远程制动、靠边停靠等操作，第一时间规避安全事故；记录处置全过程，留存事件日志。\n-遇到交通事故、人车冲突，第一时间上报，留存音视频证据，协同现场人员、交警处理事件。\n3、远程协助与数据反馈\n-对车辆违规告警、剐蹭、卡顿、信号弱等事件进行分类登记，填写安全事件台账，做好事件复盘，同步反馈技术/运维团队。\n-配合安全管理，整理安全报表，参与安全案例复盘，提出远程监控优化建议；落实无人车安全运营规范。\n4、上岗与合规\n-严格执行值守排班制度，做好交接班，交接车辆风险点、未闭环异常、重点路段注意事项。","Require":"1、大专及以上学历\n2、具备3年以上安全员、设备监控、车辆调度、运维值守