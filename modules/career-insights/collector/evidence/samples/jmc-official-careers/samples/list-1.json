5 年以上智能座舱团队管理经验。具备深厚的软件背景与座舱硬件背景经验；\n3、 具备带领200+人员规模研发团队的实战经验，必须拥有汽车整车公司从业背景，且任资深经理以上岗位，有同等岗位管理经验者优先；\n4、 具备智能座舱产品从0-1完整投产经验，主导过至少2个及以上量产项目，熟悉车规开发流程，能解决量产落地过程中的复杂技术与管理问题；\n5、 深度理解主流智能座舱芯片、域控硬件的技术特性、需求定义及市场趋势，精通座舱系统架构，具备较强的技术决策与方案评审能力；\n6、 具备前瞻创新思维，主动拥抱智能座舱行业新技术、新理念、新生态；乐于吸纳跨界思路与多元观点，敢于突破业务与流程壁垒，持续推动座舱产品体验、技术方案等迭代升级；\n7、 能适应智能座舱技术高速迭代、市场需求多变的行业节奏；可承受多项目并行的高压工作环境，灵活应对需求变更、研发卡点及各类突发状况；快速适配组织架构调整、跨部门跨团队协作及业务战略转型，高效适配行业与公司发展变化。","ClassificationOne":"汽车研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-11-12T10:24:39","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"e2e2e0f0-9db3-49c5-86ee-21710b13ab10","HeadCount":0,"JobAdId":561323303,"PostDateInt":1794449332000,"PostDate":"2026-11-12T10:08:52","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"硬内饰工程师","OrgId"