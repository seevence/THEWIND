ount":0,"JobAdId":151093371,"PostDateInt":1761568852000,"PostDate":"2025-10-27T20:40:52","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"装配工程师（装配调式）(J10362)","OrgId":891370,"Org":"解决方案开发部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"1.自研的非标自动化设备的机械装配调试\n2.处理走线过程中的接线异常以及线路排查\n3.设备运行的故障分析和精度提升诊断，总结设备安装调试过程中出现的问题，积极寻求改善方案\n4.服从公司的工作安排：能配合出差装配、调试，对工作进行总结形成报告。","Require":"任职资格：\n1.大专及以上学历，电子、电气、机电一体化相关专业，具有一定机械和制图方面的基础知识；\n2.有非标自动化设备丰富调试和装配经验；对机械、液压、气压传动原理有一定深度理解；\n3.能看懂电气及电路图，并输出装配设备的IO表；能判断处理光电、感应器、电机等异常；能按机构装配图纸进行设备装配；\n4.熟练掌握设备电子/电气调试及机加工的工具:万用表,千分尺等；具备打孔、攻丝、公差配合等调试技能；\n5.懂PLC优先,有电工证优先\n6.逻辑清晰,良好的表达能力,能吃苦耐劳，服从安排，有较强责任心","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"大专","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-10-27T20:40:52","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"4d5940a0-a426-43e5-9b8b-d4eab3fc15d4","HeadCount":0,"JobAdId":151093369,"PostDateInt":1761568852000,"PostDate":"2025-10-27T20:40:52","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"机器人系统工程师(J10369)","OrgId":891375,"Org":"关键技术研究部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["上海市"],"Salary":"面议","Duty":"待定","Require":"待定","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":"2年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-10-27T20:40:52","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"c37280d7-c8e9-41fa-a026-b2161c11dc40","HeadCount":0,"JobAdId":151093368,"PostDateInt":1761568852000,"PostDate":"2025-10-27T20:40:52","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"焊接工艺工程师(J10371)","OrgId":891379,"Org":"软件开发部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"岗位核心目标\n负责公司产品焊接工艺的开发、优化与标准化，解决生产过程中的焊接技术难题，确保焊接质量符合规范与标准，通过工艺创新持续提升生产效率和产品质量，降低制造成本。\n \n主要职责\n1. 工艺开发与文件编制：\n◦ 负责新产品焊接工艺的开发和评定，制定焊接工艺规程（WPS）、工艺指导书（WI）等核心技术文件。\n◦ 根据产品设计和标准要求，进行焊接工艺评定（PQR/WPQ），并确保其有效性。\n2. 现场技术支持与问题解决：\n◦ 深入生产一线，为焊接生产提供实时技术支持，指导焊工正确执行焊接工艺。\n◦ 分析并解决生产过程中出现的焊接缺陷（如气孔、裂纹、未熔合等），提出根本原因分析和纠正预防措施。\n3. 材料与设备选型：\n◦ 参与焊接材料的评估与选型，包括焊条、焊丝、保护气体等。\n◦ 参与新焊接设备（如机器人焊机、激光焊设备）的调研、选型和验收工作。\n4. 工装夹具设计与优化：\n◦ 根据产品结构，设计或提出焊接工装、夹具的改进方案，以提高焊接精度和生产效率。\n5. 质量与标准符合性：\n◦ 协同质量部门进行焊接质量审核，确保所有焊接活动符合内部质量体系和外部标准（如ISO 3834, ASME, AWS, EN等）的要求。\n◦ 分析焊接检验报告（NDT、力学性能测试等），并据此优化工艺。\n6. 持续改进与成本控制：\n◦ 持续优化现有焊接工艺，提升焊接速度、降低材料损耗和能源消耗，实现降本增效。\n◦ 引入和推广焊接新技术、新工艺，提升公司焊接制造水平。\n7. 培训与知识传承：\n◦ 负责对焊接操作人员和技术员进行焊接工艺理论与实操培训。","Require":"必备条件：\n• 学历与专业： 大专及以上学历，焊接技术与工程、材料成型及控制工程（焊接方向）、机械工程及相关专业。\n• 工作经验： 3年以上制造业焊接工艺相关工作经验，有机器人焊接编程或自动化焊接经验者优先。\n• 专业知识：\n◦ 精通各种焊接方法（如GMAW/MIG、GTAW/TIG、SMAW、激光焊等）及其工艺特点。\n◦ 熟悉常用金属材料（如碳钢、不锈钢、铝合金等）的焊接性和焊接要点。\n◦ 熟悉焊接工艺评定流程和国际国内焊接标准（如AWS, ASME, GB等）。\n◦ 能熟练阅读机械图纸，熟悉GD&T（几何尺寸与公差）者优先。\n• 能力与素质：\n◦ 具备强烈的质量意识、安全意识和责任心。\n◦ 拥有优秀的问题分析能力和解决能力，能应对生产现场的技术挑战。\n◦ 良好的沟通能力和团队合作精神。\n◦ 能够熟练使用Office办公软件及AutoCAD/SolidWorks等2D/3D制图软件。","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"大专","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Chan