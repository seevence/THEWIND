e":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-12-17T15:05:56","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"467b4ba3-f799-4453-b2c8-8ee92db30b03","HeadCount":0,"JobAdId":151115607,"PostDateInt":1765768422000,"PostDate":"2025-12-15T11:13:42","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"机械结构工程师(J10498)","OrgId":2345715,"Org":"杭州研发部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["浙江省·杭州市"],"Salary":"面议","Duty":"结构设计： 负责四足机器人腿部、躯干等关键机械结构的设计，包括传动系统（如关节模组）、骨架、外壳等。\n仿真与优化： 运用有限元分析（FEA）等进行静力学、动力学和疲劳寿命仿真，确保结构强度、刚度并实现轻量化设计。\n原型制作与测试： 跟进零件的加工、装配和调试，主导结构相关的测试验证，分析并解决测试中出现的问题。\n技术文档编写： 完成产品BOM、二维工程图、装配说明等技术文档的编写与维护。\n跨部门协作： 与硬件、电机、软件算法等团队紧密合作，确保机械结构与电气、控制系统的完美集成。","Require":"学历专业： 机械工程、车辆工程、航空航天等相关专业，本科及以上学历。\n经验技能：\n熟练掌握至少一款三维设计软件（如SolidWorks,  Creo/ProE）。\n具备丰富的有限元分析经验，能熟练使用ANSYS、Abaqus或同类软件。\n熟悉常用的金属材料（如铝合金、钢材）及非金属材料（如工程塑料、碳纤维）的特性与应用场景。\n了解常见的加工工艺（CNC、压铸、注塑、粉末冶金、增材制造等）和公差与配合。\n\n加分项（具备以下经验者优先）：\n有足式机器人、外骨骼、无人机或其它高性能运动平台的结构设计经验。\n有消费电子产品的大规模量产经验，参与或主导一款产品从0-1-100的全生命周期设计。\n有机器人相关竞赛经历（Robocon，RoboMaster）\n熟悉传动设计（如少齿差减速器、行星减速器、滚珠丝杠等）和轴承选型。\n具备动力学建模或多体动力学仿真（如Adams）经验。\n对机器人运动控制有基本了解。\n\n个人素质： 具备出色的动手能力、问题解决能力和团队协作精神，对机器人技术充满热情。","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Stat