ard":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-05-18T21:51:46","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"c71ee0dc-d680-4d26-9837-c36e7cfe3865","HeadCount":0,"JobAdId":151179095,"PostDateInt":1776334088000,"PostDate":"2026-04-16T18:08:08","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"区域销售主管(J10672)","OrgId":891366,"Org":"国内工业营销中心","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["全国"],"Salary":"面议","Duty":"【岗位职责】\n1、统筹省级区域为单位的销售团队管理，制定区域营销策略、业绩目标与执行方案，高效达成团队合同签约、回款双核心指标；\n2、主导区域市场深度开拓与品牌推广，精准挖掘优质客户资源，联动行业销售协同作战，全力冲刺区域销售任务；\n3、负责多维度搜集行业趋势、竞品动态及市场数据，整合区域内外部优质资源，为市场决策与业务拓展提供支撑；\n4、维护区域客户关系，传递品牌价值与产品优势，持续提升公司品牌影响力与客户认可度；\n5、负责打造区域客户标杆案例和挖掘产品的应用场景并进行规模化复制；\n6、负责完成上级安排的其它工作。","Require":"【岗位要求】\n1、拥有8 年及以上自动化领域销售实战经验，具备工业机器人、协作机器人、工业自动化相关销售经验者优先录用；\n2、商业嗅觉敏锐，执行力、逻辑思维与自我驱动力拉满，追求卓越业绩，具备优秀的团队协作与跨部门协同能力；\n3、有销售团队管理经验者优先，可独立带队攻坚市场、赋能团队成长；\n4、精通销售全流程打法，市场开拓、商务谈判能力突出，能高效落地客户转化；\n5、手握优质集成商、代理商资源，或具备大型制造企业客户资源者，优先破格录用。","ClassificationOne":"销售类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null