nd cabinet, alarm cover, etc.\n5. Regularly organize product training and assessment activities for channel clients","Require":"1. 英语可为工作语言，书面、口头交流无障碍\n2. 3C、家电产品品牌销售背景或本地KA采购背景，从业年限不低于3年\n3. 具备较强的沟通协作能力，能够承压，化压力为动力推动目标达成\nQualification Demand\n1. English can be the working language, written and verbal communication without issues\n2. Consumer electronics / home appliance brand sales background or local KA purchasing background, with no less than 3 years of experience\n3. Strong communication and collaboration skills, able to undertake pressure and turn it into motivation to promote goal achievement.","ClassificationOne":"营销类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-30T16:38:57","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"a90a901a-beaa-4840-bc0f-1c6ab