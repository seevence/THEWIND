:0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"3a55baf2-c519-4cdd-ad2c-ea1ebfc5982d","HeadCount":0,"JobAdId":351627747,"PostDateInt":1794543241000,"PostDate":"2026-11-13T12:14:01","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"中高级FAE工程师（flash）(J12306)","OrgId":3497927,"Org":"销售与管理组","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"15K-25K 元/月","Duty":"1、配合销售和市场解决客户现场分析技术问题\n2、收集客户反馈问题的信息，并整理存档同步给研发跟进问题分析\n3、客诉问题拉通质量研发项目推动改善","Require":"1、本科及以上学历，电子类专业\n 2、熟练使用示波器，逻辑分析仪，电烙铁，热风枪等设备\n 3、熟悉Nor flash和NAND flash 的规格书和SPI协议\n 4、熟悉宇思微、富瀚微、凌阳、杰理，中科蓝讯等 平台者优先\n 5、有Nor flash 和NAND  flash 的工作经验优先","ClassificationOne":"销售","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-11-13T12:14:01","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"9fd564ad-329c-4a09-b0e0-4476f583f596","HeadCount":0,"JobAdId":351625862,"PostDateInt":1793945026000,"PostDate":"2026-11-06T14:03:46","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"AB2 前段工艺技术员（社招）(J12285)","OrgId":2917129,"Org":"前段工艺部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·东莞市"],"Salary":"8K-10K 元/月","Duty":"1、当班工艺执行与生产保障：负责所辖工序日常生产、机台操作、参数核对与制程监控，严格按照 SOP 完成量产及试产作业，负责换线换型的程序调用、首件确认与上下料协调，保障线体稳定生产与当班计划达成。\n2、量产工艺稳定性监控：监控当班关键工艺参数与产品品质，执行定时巡检、抽检与工艺点检，发现参数偏差、制程波动及时调整处置，确保工艺处于管控范围内。\n3、一线异常处置与上报：负责当班工艺不良、设备及物料异常的初步响应，做好不良识别、隔离、应急处理与记录；复杂问题及时上报白班工程师并协助分析，做好现场保留、数据提供与返工执行。\n4、工艺文件与标准化执行：执行本工序 SOP、管控规范与点检计划，做好首件确认与日常点检；协助更新作业指导文件，对一线作业人员开展基础操作带教，落实制程纪律与品质规范，遵守安全操作规程并保持作业区域 5S。\n5、数据记录、交接与改善配合：准确填写当班工艺、生产、不良记录及交接班报表，统计良率、不良与设备异常数据；反馈重复性问题，配合落实良率与效率改善对策。\n6、协助验证与试产：协助工艺工程师开展新品导入、工艺验证、DOE 实验、参数优化及良率提升工作，准确记录实验数据、留存不良影像、整理生产台账，为新材料 / 新设备导入提供数据支持。\n\n熟悉以下任一方向工艺即可：\n1、FC 倒装：熟悉倒装贴片工序的机台操作与参数核对（贴装温度、压力、时间、助焊剂涂布、贴装精度及 Bump 对位），能识别偏移、翘曲、冷焊、空洞、桥连等不良，有倒装或先进封装量产经验者优先。\n2、UF 底部填充：熟悉底部填充工序的点胶路径、胶量、温度及固化参数管控，能识别填充不完全、空洞、气泡、溢胶、爬胶等不良，有 Underfill 工艺经验者优先。\n3、SMT 贴装：熟悉锡膏印刷、贴片、回流焊关键工序，能监控印刷厚度、贴装偏移及回流温度曲线，能识别少锡、连锡、立碑、虚焊、空洞等不良，有 SMT 量产线经验者优先。","Require":"1、大专及以上学历，电子、微电子、化学、物理、材料等相关专业；\n2、有半导体或集成电路封测行业经验者优先，可接受优秀应届毕业生；\n3、有一定英语基础，能看懂英文 SOP、设备界面及 Recipe 参数；\n4、能适应两班倒及无尘车间作业环境，服从生产排班安排；\n5、具备 SPC、良率数据的基本认知，数据意识强，能规范填写记录与交接班报表；\n6、有较强的学习能力和动手能力，具备良好的沟通能力及团队协作精神，积极完成上级领导安排的任务；\n7、工作细致严谨，具备良好的问题观察能力、记录能力和分析能力，执行力强、服从生产安排。","ClassificationOne":"工程/生产（东莞）","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status