与病人及病人家属沟通，严防医疗差错事故。\n4、承担医院及科室安排的门急诊、病房患者的诊治工作、院内会诊工作以及医院各项指令性任务。\n5、参加和指导住院医师进行诊断、治疗及特殊诊疗操作，严格遵守医疗操作规范，就所服务病人向相关主诊医师负责。\n6、带领下级医师每日早晚查房，随时掌握病人每日病情变化，及时审签、完善本主诊组病人的医疗记录，根据病情发展，及时下达医嘱或向主诊医师汇报后立即遵照主诊医师指示进行处理。轮值时对于非本主诊组的病患也要尽到同样责任。","Require":"1.具备5年以上三级综合医院规培&工作经验，熟悉门诊和病房工作，能够独立值班；\n2.初级和中级职称，其中初级职称需要规培证书；\n3.教育程度:本科及以上，硕士学历优先，临床医学、外科学。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-01T10:37:28","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"75c34f4c-b30e-4c0c-a9cc-24530ef16487","HeadCount":0,"JobAdId":880101561,"PostDateInt":1788228046000,"PostDate":"2026-09-01T10:00:46","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"肺功能技师岗(J53639)","OrgId":2339797,"Org":"北京医院项目","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames