ard":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-07-31T16:20:05","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"0f26e2bf-fe4b-4514-8818-b36c2c7877fe","HeadCount":0,"JobAdId":311030901,"PostDateInt":1753948600000,"PostDate":"2025-07-31T15:56:40","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"供应商质量管理工程师","OrgId":946467,"Org":"供应商质量管理部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·扬州市·仪征市"],"Salary":"8K-15K 元/月","Duty":"1、快速响应与问题诊断：\n（1）、及时响应客服、市场反馈：接到客服、市场关于原材料异常的售后问题后，迅速做出反应，安排调查和处理。\n（2）、调查与问题分析：对异常情况进行详细调查，分析异常原因（如质量问题、规格不符、性能不达标等）。\n（3）、数据收集与记录：收集相关数据（如批次信息、使用记录、检测报告等），建立完整的异常问题档案。\n2、制定解决方案：\n（1）、根据问题分析结果，提出合理的解决方案，如更换原材料、退货、补偿等。\n（2）、协调资源：与供应商、生产部门、采购部门等协调，确保解决方案能够快速实施。\n（3）、监督执行：跟进解决方案的执行情况，确保问题得到有效解决。\n3、质量追溯与改进：\n（1）、追溯原材料来源：调查异常原材料的供应商、批次、采购渠道等信息，确定问题的根本原因。\n（2）、推动质量改进：向供应商反馈问题，要求改进原材料质量，或协助公司内部优化原材料使用流程。\n（3）、制定预防措施：分析问题原因，提出预防措施，避免类似问题再次发生。\n4、与供应商沟通协调\n（1）、供应商责任认定：与供应商沟通，明确问题责任归属，协商解决方案。（2）、索赔处理：根据合同条款，协助公司进行索赔或退货处理。\n（3）、维护供应商关系：在解决问题的过程中，保持与供应商的良好沟通，维护长期合作关系。\n5、与客服、市场沟通协调\n（1）、客服沟通与协调：及时与客服、市场沟通，同步问题处理进展。\n6、技术支持与培训：对内部团队（如采购、生产、质检等）进行原材料相关知识的培训，提升整体技术水平。\n7、数据记录与报告\n（1）记录异常问题：详细记录每次原材料异常问题的处理过程、原因分析和解决方案。\n（2）定期报告：向管理层汇报客诉原材料异常问题的处理进展及改进措施，提供数据支持。\n（3）分析异常原因：通过数据分析，总结原材料异常问题的规律，提出改进建议。\n8、供应链优化\n（1）优化采购流程：根据原材料异常问题的分析结果，优化原材料采购流程，减少问题发生的概率。\n（2）建立备用供应商：在必要时，协助公司建立备用供应商，避免因单一供应商问题导致供应链中断。\n（3）成本控制：在处理异常问题的同时，关注成本控制，确保解决方案经济可行。\n9、技术研发与创新\n（1）材料替代方案：在原材料异常问题导致供应不足时，协助研发部门寻找替代材料。\n（2）工艺改进：根据原材料特性，提出生产工艺改进的建议，提升产品质量。","Require":"1、学历：本科及以上，专业： 电气工程及自动化、能源与动力、电子信息工程、机械工程、机械涉及制造及自动化。\n2、有5年以上电源、逆变器等电力电子行业相关岗位经验。\n3、熟悉储能户外柜、集装箱，及配套电气集成相关产品，例如通讯柜、汇流柜等。\n4、有一定的电力、电子硬件工程师岗位工作经验。\n5、参与过工商储项目集成交付类的相关工作。\n6、有2年以上的客诉问题处理经验。\n7、熟练运用8D。\n8、常用办公软件熟练，特别是Word、Excel及PPT软件等；\n9、具有较强的异常分析能力；\n10、良好的沟通协调及表达管理能力，思路清晰。\n11、做事认真负责有原则，态度端正。","ClassificationOne":"制造","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-07-31T15:56:40","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"D