全套协议栈从零开发与适配改造；\r\n3、精通 TCP/IP 网络协议、Socket 通信、断线重连、消息序列化与校验机制，熟悉工业通信时序、并发处理、异常容错机制，具备高稳定性工业通信软件开发经验；\r\n4、熟练掌握面向对象编程、设计模式、模块化架构设计，具备规范的编码习惯；熟悉版本管理工具（Git/SVN）、单元测试、性能调试、日志排查，可独立完成需求拆解、方案设计、编码落地、自测闭环；\r\n5、熟悉半导体设备自动化流程，了解 EAP、MES、Host 工厂自动化系统对接逻辑，熟悉晶圆厂量产联机标准，有刻蚀、沉积、检测、清洗等半导体设备开发经验者优先；\r\n\r\n加分技能：\r\n1、拥有自研 SEMI 协议 SDK、协议中间件开发经验，支持多设备复用者优先；\r\n2、熟悉 EDA、OPC UA 等工厂自动化通信协议，具备多协议融合开发经验；\r\n3、具备英文技术文档阅读能力，可独立研读 SEMI 官方标准手册。","ClassificationOne":"社会招聘","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-08-07T15:40:08","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"7ca7110e-04d5-4023-a540-d867ed46730b","HeadCount":0,"JobAdId":190846380,"PostDateInt":1786088408000,"PostDate":"2026-08-07T15:40:08","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"SECS/GEM资深开发工程师-西安"