,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-11-05T11:08:00","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"7d914ded-b181-437e-afcc-ae1a0e412592","HeadCount":0,"JobAdId":621158196,"PostDateInt":1792568044000,"PostDate":"2026-10-21T15:34:04","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"MEMS封测工程师(J10559)","OrgId":0,"Org":"默认部门","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["四川省·成都市·双流区"],"Salary":"面议","Duty":"1.负责 MEMS 器件封装方案设计，结合产品应用需求完成封装结构优化与方案迭代。\n2.负责 MEMS 封装工艺开发与可制造性管理，与设计、工艺工程师及封装厂密切协作，解决封装工艺实现中的技术问题，确保封装的可靠性与可量产性。\n3.撰写封装设计规范、仿真报告、测试方案等技术文档，参与设计评审与工艺评审，保障封装方案的合规性与落地性。\n4.跟踪 MEMS 先进封装技术与测试标准，开展技术预研，持续优化封装设计体系与测试核心技术能力。","Require":"1.硕士及以上学历，微电子、机械工程、材料科学、物理等相关专业，精通 MEMS 工作原理与封装技术。\n2.精通至少一款多物理场仿真软件。\n3.具备 MEMS 器件封装与测试经验，有成功量产案例经验者优先。\n4.具备规范的中英文技术文档撰写与英文读写能力，问题解决能力突出，拥有良好的团队协作与跨部门沟通能力。","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-21T15:34:04","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"f81ebd36-2910-4fab-afe6-32c731b9f5cd","HeadCount":0,"JobAdId":621158039,"PostDateInt":1792551982000,"PostDate":"2026-10-21T11:06:22","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"SI/PI/射频仿真工程师(J10509)","OrgId":0,"Org":"默认部门","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["四川省·成都市·双流区"],"Salary":"面议","Duty":"1.\t负责硅光调制器/铌酸锂调制器/高速PD 电极结构的设计及开发\n2.\t解决电光芯片片上及封装结构中的信号完整性（SI）与电源完整性（PI）问题；\n3.\t针对电光芯片在多种先进集成封装形式中的射频相关问题（如串扰、插损、回损等）进行分析与优化；\n4.\t与高速PCB设计团队协作，共同完成PCB与PIC（光子集成电路）整体链路的系统级评估；\n5.\t处理射频测试过程中及数据后处理环节中遇到的技术问题；\n6.\t配合光学团队或硬件团队完成硅光芯片的使用和调试","Require":"1.\t电磁场与微波技术相关专业硕士及以上学历\n2.\t具备SI/PI相关项目经验，拥有高速微波电路设计背景\n3.\t有先进封装经验（如2.5D/3D封装、chiplet、Fanout）项目经验者优先\n4.\t熟练掌握信号完整性及电源完整性分析工具，如HFSS、Siwave、ADS、Candence Sigrity等\n5.\t熟练掌握矢量网络分析仪的使用，了解其基本原理\n6.\t良好的沟通能力和团队协作能力，能够与跨职能团队高效合作\n7.\t具备较强的问题分析和解决能力，能够在压力下按时完成任务","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Chann