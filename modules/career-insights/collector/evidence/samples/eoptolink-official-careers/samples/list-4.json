":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-02-10T14:16:03","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"6362c087-3199-49fe-938b-b3999ffcec1c","HeadCount":0,"JobAdId":621064645,"PostDateInt":1769045515000,"PostDate":"2026-01-22T09:31:55","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"总经办秘书(J10463)","OrgId":433080,"Org":"总经办","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["四川省·成都市·双流区"],"Salary":"10K-20K 元/月","Duty":"1、协助总经理管理各部门间的日常协作事务，同时作为对内沟通桥梁，准确及时地将总经理的指示传达给相关部门或人员，并跟进反馈；\n2、负责科学、严谨地安排总经理的日程，并提前进行提醒与确认；\n3、负责总经理国内外出差的全程规划与安排，并陪同出差，做好出差期间的行程管理；\n4、负责各项会议的通知与组织，撰写会议纪要，并跟踪决议事项的落实；\n5、负责访客接待全流程管理，统筹安排来访总经理的预约，对重要访客进行迎送、引导与陪同，确保接待过程专业、周到、得体；\n6、负责总经理办公室的日常维护，确保工作环境高效、整洁；\n7、负责接收、呈报所有送至总经理的信函、传真、快递等，确保信息不遗漏、不延误。根据总经理要求，熟练起草日常通知、演讲稿或演示文稿；\n8、负责协助处理总经理工作以外的各项私人事务；\n9、负责高效、稳妥地完成总经理交办的其他临时性、紧急性事务。","Require":"1、硕士学历，优秀本科生也可考虑，专业不限，英文口语及书面表达能力优秀，接受应届毕业生；\n2、形象气质佳，熟练掌握国内外商务礼仪，具备优秀的接待素养，细节考虑周全，能独立处理接待中的突发状况；\n3、优秀的组织与时间