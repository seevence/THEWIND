ription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-08-28T17:26:27","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"e694f995-b3ed-405b-9adb-6f43a08c4497","HeadCount":0,"JobAdId":561293902,"PostDateInt":1787909166000,"PostDate":"2026-08-28T17:26:06","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"高级嵌入式软件工程师（ufs）(J10856)","OrgId":2103224,"Org":"UFS研发组","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·中山市"],"Salary":"面议","Duty":"岗位职责\n  \n   • 熟悉UFS协议栈开发，包括链路管理、物理层协议（UIC）、逻辑层（LBA映射、错误恢复）等模块设计与实现；  \n\n   • 主导UFS固件性能优化，解决读写延迟、功耗控制、GC算法效率等关键问题；  \n\n   • 开发与NAND Flash适配的FTL（Flash Translation Layer）算法，提升存储寿命和可靠性。\n\n   • 完成UFS控制器与主控芯片的软硬件协同设计；  \n\n   • 设计自动化测试框架，覆盖压力测试、异常场景模拟（如断电恢复、温度循环）；  \n\n   • 分析客诉问题，定位固件层缺陷（如数据校验失败、RMA不良品修复）。","Require":"任职要求\n\n1. 基础能力  \n   • 本科及以上学历，计算机、电子、微电子、自动化相关专业，1-5年以上嵌入式开发经验；  \n   • 精通C语言，开发调试手段。\n\n2. 技术专长  \n   • 深入理解UFS 3.1/4.0协议协议栈者优先；  \n   • 掌握NAND Flash特性（TLC/QLC、磨损均衡、坏块管理）及FTL算法实现；  \n   • 具备UFS控制器的项目开发经验，熟悉嵌入式软件调试手段；\n   • 具备安卓平台的驱动调试经验；\n\n3. 项目经验  \n   • 主导或参与过UFS主控芯片、SSD、eMMC存储产品的固件开发项目；  \n   • 有量产项目经验，熟悉JTAG/示波器等硬件调试工具。\n\n4. 软性素质  \n   • 具备复杂问题拆解能力，能独立完成技术文档编写（设计文档、测试用例）；  \n   • 抗压能力强，适应快速迭代开发及跨部门协作。","ClassificationOne":"研发","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":f