sCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-07-01T16:46:55","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"c26d9a75-7f71-441f-83fb-f9d164b81cba","HeadCount":0,"JobAdId":561264053,"PostDateInt":1781487166000,"PostDate":"2026-06-15T09:32:46","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"SQE供应商质量工程师(J12658)","OrgId":1584402,"Org":"质量工程组","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市"],"Salary":"面议","Duty":"1、具备芯片质量相关知识：熟悉杰发科技相关芯片产品（如 MCU 和 SOC 等）的质量标准和技术规格，了解芯片生产工艺流程和质量控制要点；\n2、具备质量管理体系知识：掌握 ISO 9001、IATF 16949 等质量管理体系的基本原理和方法，能协助供应商建立和完善质量管理体系；\n3、具备数据分析能力：具备数据收集、整理、分析能力，能运用统计工具对供应商质量数据（如进货检验合格率、产品不良率等）进行分析，为质量决策提供数据支持；\n4、问题解决能力：能独立解决供应商质量管理中的常见问题（如不合格品处理、质量事故调查分析），制定整改措施并跟踪效果\n5、供应商管理能力：了解供应商管理流程和方法，能监控供应商生产过程，发现潜在质量风险并提出改进措施；参与供应商评估和选择工作\n6、沟通协调能力：与公司内部研发、生产、采购等部门密切协作，传递供应商质量信息，共同解决产品质量问题；能与供应商有效沟通，推动质量改进\n7、项目管理经验：有一定项目管理经验，能独立承担某方面工作或项目的策划并推动执行\n8、行业认知：了解芯片行业发展趋势和市场动态，关注新技术、新方法并应用到岗位工作中\n","Require":"任职资格\n1、微电子、半导体、电气自动化，质量管理相关专业等理工类，本科及以上学历\n2、三年以上半导体行业质量管理经验，车规汽车电子工作经验为佳\n3、熟悉 IATF16949 标准、熟悉 VDA6.3 过程审核、VDA6.5 产品审核，有对应审核员证书","ClassificationOne":"研发","ClassificationTwo":" 杰发科技&武汉杰开","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-15T09:32:46","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"a08aa9fb-76d0-44a1-b875-2c478963fc9c","HeadCount":0,"JobAdId":561264048,"PostDateInt":1781487050000,"PostDate":"2026-06-15T09:30:50","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"数字系统验证工程师(J12657)","OrgId":1584378,"Org":"验证组","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"1. 芯片定义阶段协助进行芯片规格的需求分析；\n2. 理解芯片架构和内部模块功能，设计验证方案和计划；\n3. 硅前进行仿真验证环境搭建，开发测试用例，对各模块裸机/Linux/FreeRTOS等开发验证驱动，开发Bootrom，基于FPGA/Palladium等进行仿真验证，完成验证报告；\n4. 硅后基于EVB/Demo/SLT/HQA板进行IC模块和系统的功能/性能/带宽/功耗等验证，并协助硬件进行HQA测试；\n5. 搭建SLT封测软件环境，设计验证用例，SLT产线环境部署和软件更新迭代支持；\n6. 支持系统软件开发和客户问题分析解决；\n7. 支持客退IC问题分析。","Require":"1. 计算机、微电子等相关专业，本科毕业3年，硕士毕业2年；\n2. 熟悉软