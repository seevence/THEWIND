verCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"af5e0588-1cea-43e7-91ee-546e7d2f80a2","HeadCount":0,"JobAdId":561212913,"PostDateInt":1769172585000,"PostDate":"2026-01-23T20:49:45","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"售前技术工程师(J12393)","OrgId":1584035,"Org":"SOC业务部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市","广东省·深圳市","上海市"],"Salary":"面议","Duty":"1、依据车规芯片厂商需求，定制适配杰发科技 SOC 产品的技术方案，涵盖硬件架构、软件功能等设计，突出产品优势与差异化。\n2、与车规客户深度交流，解答技术疑问，挖掘需求痛点，为销售提供专业技术支撑，助力客户选型决策。\n3、参与投标、项目评估等售前环节，编写技术标书，进行方案宣讲，协同销售推动项目进展，提升中标率。\n4、参加行业展会、研讨会，介绍杰发 SOC 产品特性与应用案例，收集市场反馈，助力产品优化与市场拓展。\n5、调研竞品动态，对比分析技术性能，为公司制定竞争策略提供依据 。","Require":"1、本科及以上学历，电子信息、计算机、汽车电子等相关专业。\n2、具备3 年以上车规芯片或相关领域技术支持、售前经验，熟悉车规芯片应用场景。\n3、熟悉 SOC 芯片架构，掌握嵌入式系统开发，了解 CAN、LIN 等汽车通信协议；具备良好的方案撰写与演讲能力。\n4、沟通协作能力强，能快速理解客户需求、解决技术问题；学习能力佳，紧跟行业技术发展。\n5、适应出差，具备基本英文读写能力，可阅读英文技术资料 。","ClassificationOne":"销售","ClassificationTwo":" 杰发科技&武汉杰开","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4Exter