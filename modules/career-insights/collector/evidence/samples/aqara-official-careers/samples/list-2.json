peatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"56ec0271-3888-45cc-9ce7-951e69f7b918","HeadCount":0,"JobAdId":270980716,"PostDateInt":1789012100000,"PostDate":"2026-09-10T11:48:20","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"高级NPI工程师","OrgId":2850260,"Org":"中试部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"15K-30K 元/月","Duty":"1、DFX体系搭建：统筹产品开发前期DFX评审工作，维护更新评审清单，优化评审流程，标准，工具。\n2、设计规范统筹：协同硬件、结构、包装、品质部门，完善产品设计规范体系，推动设计与制造协同优化。\n3、试产统筹管控：统筹多品类产品试产全流程，优化试产方案，管控试产进度、成本与品质，高效解决复杂试产异常。\n4、量产转化统筹：牵头推动新产品量产转化，拉通计划、物控、生产、外协厂资源，保障量产顺利落地。\n5、团队指导与外协管理：指导初级、中级NPI工程师开展工作，管理外协团队，搭建高效协同机制。\n6、QCT改善统筹：主导量产产品QCT持续改善，深挖改善方案与空间，制定优化策略并推广落地，提升产品竞争力。\n7、流程优化升级：AI工具的使用，优化NPI工作流程，完善作业标准，提升新产品导入效率与质量。","Require":"1、教育背景\n全日制本科及以上学历，电子、制造工艺、工业工程、供应链管理等相关专业优先。\n2、知识 / 技能\n精通新产品导入（NPI）全流程管理，擅长DFX体系搭建与优化，具备多品类产品NPI统筹能力。\n具备较强的项目管理与流程优化能力。\n具备5年以上电子产品NPI相关工作经验，有海外锁，IPC行业从业经验优先。\n具备重大试产异常解决、外协团队管理、跨部门协同推进能力。\n有驾照，可适应一定出差。\n3、行为 / 素质\n统筹规划能力强，思路清晰，具备较强的风险意识、改善思维和团队指导能力。\n责任心强，抗压性好，具备良好的推动力与专业影响力，能高效管理外协团队。","ClassificationOne":"生产供应链类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null