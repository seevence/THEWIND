e":null},{"Id":"38067223-378c-4f86-ae1f-3c98b2fea1f8","HeadCount":0,"JobAdId":351627155,"PostDateInt":1794377099000,"PostDate":"2026-11-11T14:04:59","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"SSD固件开发工程师(J14931)","OrgId":700612991,"Org":"企业级固态硬盘产品事业部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["四川省·成都市"],"Salary":"面议","Duty":"负责企业级SSD固件中前端开发工作，包括协议实现、兼容性优化、性能调优等，确保SSD与主机系统的高效交互和稳定运行，提升产品的整体性能和兼容性。\n- 协议开发与维护：负责SSD固件中NVMe/PCIe/SMBus等前端协议的实现与维护，确保SSD与主机之间的通信符合协议规范，能够正确处理各种命令和数据传输。\n- 兼容性优化：针对不同的主板、操作系统、BIOS等环境，进行兼容性调优与分析，解决遇到的兼容性问题，确保SSD在各种平台上都能稳定工作。\n- 性能优化：对SSD前端固件进行性能分析和优化，提高数据传输速度、降低延迟，提升SSD的整体性能表现，满足企业级应用对存储性能的高要求。\n- 问题定位与解决：在SSD开发和测试过程中，快速定位并解决前端相关的问题，如协议错误、兼容性故障、性能瓶颈等，保障项目的顺利进行。\n- 文档撰写与维护：编写相关的技术文档，包括设计文档、开发文档、测试文档等，记录开发过程中的技术细节和解决方案，方便后续的维护和升级。","Require":"- 教育背景：本科及以上学历，电子、控制、测控、通信、计算机、仪器仪表等相关专业。\n- 专业技能：熟练掌握C语言编程，有良好的嵌入式开发经验；熟悉Linux内核开发，掌握ARM多核开发技术，深入理解多线程及RTOS技术。\n- 工作经验：具有2年以上SSD固件开发经验，熟悉NVMe协议和PCIe接口，有实际的存储产品固件开发项目经验者优先。\n- 能力素质：具备较强的问题分析和解决能力，能够独立解决开发过程中遇到的各种技术问题；善于沟通协作，能够与团队成员、硬件工程师、测试工程师等密切合作。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":true,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-11-11T14:04:59","JobV