l,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-06-02T15:12:32","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"8eb5678e-225e-4e8b-9ec3-46e1dff92d52","HeadCount":0,"JobAdId":151198782,"PostDateInt":1780380576000,"PostDate":"2026-06-02T14:09:36","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"云运维工程师（包头）(J13791)","OrgId":2525871,"Org":"云计算公司","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["内蒙古自治区·包头市"],"Salary":"面议","Duty":"1、负责公司云平台、服务器及业务系统的日常运维工作，包含资源部署、日常巡检、故障排查、性能优化，每周1~2次值班，保障云端业务7×24小时稳定、高效运行，及时处理各类运维突发问题。\n2、负责计算机网络体系运维与优化，统筹公司内网、外网、专线、防火墙、交换机、负载均衡等网络设备的配置、调试、监控及维护，排查网络卡顿、中断、延迟异常等各类网络故障，优化网络架构，保障网络传输稳定、安全、高效，满足业务运行需求。\n3、负责信息安全防护与合规管理，落实云平台及业务系统的安全防护策略，定期开展安全漏洞扫描、风险排查、病毒查杀、入侵检测等工作；及时修复安全漏洞，处置网络攻击、数据泄露等安全风险；配合完成安全合规检查、日志审计、安全制度落地，保障公司网络、数据、业务系统安全可控。\n4、负责服务器操作系统（Linux、Windows）的安装、配置、升级、补丁更新及日常维护，优化系统参数，处理系统报错、进程异常、权限故障等问题，保障操作系统稳定运行。\n5、负责存储系统的日常运维管理，包含分布式存储、本地存储、云存储等设备及资源的监控、扩容、备份、整理与故障修复，保障数据存储安全、完整、可正常调取。\n6、负责运维文档、网络配置文档、安全日志、存储台账等资料的整理、更新与归档，搭建标准化运维流程，沉淀运维经验，持续提升运维效率。\n7、配合销售及售前团队完成业务上线、环境部署、压力测试等工作，提供云端运维、网络及安全技术支持。","Require":"1、大专及以上学历，计算机、网络工程、信息安全、云计算等相关专业，1-3年云运维、网络运维、信息安全运维相关工作经验，有企业云端项目运维经验者优先。\n2、精通计算机网络知识，熟练掌握TCP/IP协议、路由交换、VLAN划分、ACL策略、负载均衡、VPN、专线组网等核心技术；熟悉主流交换机、防火墙、路由器等网络设备的配置与运维，能够独立排查各类复杂网络故障。\n3、精通信息安全相关技术，熟悉网络安全、主机安全、数据安全防护体系，掌握漏洞扫描、渗透测试、入侵防御、安全审计、病毒防护、权限管控等安全技术；了解网络攻击常见手段及防御方法，具备安全风险排查、漏洞修复、安全事件应急处置能力，熟悉等保2.0相关合规要求者优先。\n4、熟练掌握主流操作系统，精通Linux系统日常运维、命令操作、权限管理、服务部署、性能调优、故障排查，熟悉Windows服务器运维管理。\n5、熟悉各类存储系统原理及运维操作，掌握云存储、分布式存储、磁盘阵列等存储设备的日常管理。\n6、熟悉主流公有云/私有云平台运维（阿里云、曙光云、vSphere等），熟悉云服务器、云网络、云存储等云资源的部署与运维。\n7、具备良好的问题排查能力、应急处置能力及抗压能力，工作严谨负责、细心踏实，拥有良好的沟通能力和团队协作意识，具备较强的学习能力，可快速适配新技术、新业务。\n8、持有网络工程相关证书、信息安全相关证书、云计算相关认证证书者优先。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":true,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"大专","YearsOfWorking":"1年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-06-02T14:09:36","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"1dd484bc-715f-44ec-9de3-b00365413dc4","HeadCount":0,"JobAdId":151196880,"PostDateInt":1779851333000,"PostDate":"2026-05-27T11:08:53","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"网络运维工程师(哈尔滨）(J13777)","OrgId":2525871,"Org":"云计算公司","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["黑龙江省·哈尔滨市"],"Salary":"面议","Duty":"独立完成交换机及网络设备配置、安全设备配置、能够独立处理网络故障","Require":"1.大专及以上学历，计算机相关专业，具有网络运维相关经验\n2.有责任心，具有文档编写能力。","ClassificationOne":null,"ClassificationTwo":