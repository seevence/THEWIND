办的其他工作。","Require":"任职要求： \n1、本科及以上学历，计算机或网络工程或网络安全或安全BM等相关专业；具备支撑软硬件集成、网络安全项目工作/实习经验优先； \n2、熟悉主流信息安全产品和解决方案，熟悉行业发展态势、行业政策、标准和法规，了解行业最新动态，熟悉等级保护、关基保护、数据安全和密码安全等相关标准和规范；熟悉各类主流的安全产品，熟练掌握态势感知、UEBA、风控、流量、蜜罐等，有项目经验者优先；\n3、形象良好、语言表达和思维逻辑清晰、性格乐观较外向、书面表达能力强；具有较强的敬业精神与工作责任心；具有快速学习能力、自我驱动力、责任心、进取心，勇于挑战，并善于进行技术资源整合及团队合作；\n4、文档处理能力较强，能独立完成等保，风险评估，安全咨询、设计、方案，安全培训，项目招投标等项目文档；\n5、具有CISSP、CISA、CISP、ISO27001LA、ITIL、PMP等相关资质者优先。","ClassificationOne":"售前","ClassificationTwo":"技术支持类","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"2年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-04-14T17:59:42","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null}],"Total":0}