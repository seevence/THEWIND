4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-06-06T09:16:14","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"d98ad123-68c6-4ed1-bc11-ec98e242e3fc","HeadCount":0,"JobAdId":151181227,"PostDateInt":1776828165000,"PostDate":"2026-04-22T11:22:45","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"BMS软件开发工程师(J12482)","OrgId":3201285,"Org":"浙江冠宇电源有限公司","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["浙江省·嘉兴市"],"Salary":"面议","Duty":"1、负责BMS 电池管理系统底层软件模块的需求分析、设计、编码与单元测试；\n2、负责MCU 底层驱动开发（ADC、CAN/LIN、SPI、I2C、GPIO、定时器、看门狗等）；\n3、负责采样、均衡、保护、诊断、安全、存储等 BMS 核心逻辑实现与调试；\n4、负责与硬件、应用层、系统团队协同，完成台架 / 实车调试、问题定位；\n5、负责遵循ISO26262、AUTOSAR、MISRA等规范，输出符合车规的高质量代码；\n6、负责版本管理、BUG 修复、性能优化与量产维护。","Require":"1、本科及以上学历，3 年以上BMS 底层开发相关经验，有量产 BMS 项目开发与上车经验优先；\n2、精通 C 语言 嵌入式开发，熟悉 MISRA 规范，能写出车规级、高可靠代码；\n3、熟悉主流车规 MCU：NXP S32K、英飞凌 AURIX、ST STM32、瑞萨等至少一种，熟练掌握MCU 外设驱动开发与调试：ADC、CAN/CAN FD、SPI、I2C、UART、PWM、WDT；\n4、熟悉BMS 工作原理：电压 / 电流 / 温度采样、被动 / 主动均衡、SOC/SOH/SOP 估算、过压 / 过流 / 过温 / 绝缘等保护逻辑；\n5、熟悉UDS/ISO15765诊断协议、CAN 信号交互、DTC 处理、数据流与刷新流程，能使用CANoe/CANape、示波器、万用表、电源、电子负载等工具调试；\n6、熟悉 AUTOSAR CP/AP 架构，有 MCAL、CDD、BSW 模块开发经验优先；了解 ISO26262 功能安全流程，有 ASIL 开发经验优先；熟悉电池包系统、硬件原理、均衡拓扑、高压安全、继电器控制优先；有 Bootloader、UDS 刷新、数据标定、存储管理（EEPROM/Flash）开发经验优先；\n7、具备较强的问题分析与定位能力，能独立解决软硬件联调问题，工作严谨、责任心强，能承受项目节点压力，良好的沟通与团队协作能力，文档规范、习惯良好。","ClassificationOne":"计算机软件类","ClassificationTwo":"浙江","Classification3":null,"Classification4":