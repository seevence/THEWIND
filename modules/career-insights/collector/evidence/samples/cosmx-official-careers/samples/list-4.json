:50","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"48c6e202-83b1-4dc3-b6ac-f8689ada8c96","HeadCount":0,"JobAdId":151105480,"PostDateInt":1763603866000,"PostDate":"2025-11-20T09:57:46","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"流体力学仿真资深工程师(J12363)","OrgId":1486897,"Org":"制造研发部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·珠海市"],"Salary":"面议","Duty":"1、负责电芯制程能力仿真，并通过仿真分析结果设计优化方案；\n2、按照项目的要求，负责流体仿真分析，并输出分析报告并提出优化方案；\n3、根据CAE分析结果给出修改建议，反馈结构工程师进行结构优化；\n4、负责试验结果与仿真结果的对标工作，制定仿真标准化流程；\n5、收集CAE分析前沿技术，持续优化仿真分析流程和内容；\n6、根据仿真与试验积累，建立电池包结构设计的仿真与试验相关技术标准。","Require":"1、本科以上学历，能源与动力、机械工程、热能动力工程等方向相关专业；\n2、候选人需有1年以上CAE方向仿真和分析经验；\n3、熟练使用Fluent、comsol、Ansys、Openfoam等仿真软件中的一种或者多种；\n4、熟悉Solidworks 等建模软件以及掌握MINITAB、Python等工具，具备数据分析挖掘能力；\n5、掌握流体力学的各种数值算法，熟悉力学、热学等基本原理；\n6、具有较强的逻辑思维能力、数据处理和数值分析的能力，具备较好的沟通协调、团队协作、分析处理问题能力，抗压能力强。","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"硕士研究生","YearsOfWorking":"1年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4Externa