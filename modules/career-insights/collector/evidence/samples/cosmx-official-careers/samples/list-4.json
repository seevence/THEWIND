{"Code":200,"Message":"operation success","MoreMessage":"","TipType":"Success","Count":118,"ReturnUrl":null,"Data":[{"Id":"2de873dc-ac44-4c45-a280-3b22753b74b7","HeadCount":0,"JobAdId":151128726,"PostDateInt":1768876985000,"PostDate":"2026-01-20T10:43:05","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"应付会计(J12402)","OrgId":1486890,"Org":"财务中心","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["重庆市","广东省·珠海市"],"Salary":"面议","Duty":"1、日常费用及采购入库单据审核、往来对账、AP发票制作、编制会计凭证\n2、审核采购部的月度付款预算、付款流程并安排付款\n3、供应商应付账款账龄的监控及清理\n4、协助参与供应商资质审查，对财务指标做出评价\n5、审核合同、补充协议并跟进扣款流程\n6、负责投资项目预算台账登记\n7、AP凭证的整理及归档\n8、配合内外部审计、税务检查、项目申报，提供应付相关的资料与解释\n9、参与优化应付流程，提升效率与风险控制能力\n10、完成上级交办的其他相关工作","Require":"1、财务、会计或相关专业本科及以上学历\n2、熟悉会计基础知识，了解企业会计准则、税法、财务报表编制等；\n3、细致严谨、具备良好的沟通能力、抗压能力、团队合作精神及责任心；熟练使用办公软件，具备基本的数据处理能力","ClassificationOne":"职能类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-01-20T10:43:05","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"Hide