escription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-12-04T14:17:29","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"ae68ec59-6ee9-4ef7-8f10-6d309bca44f9","HeadCount":0,"JobAdId":311064929,"PostDateInt":1761892962000,"PostDate":"2025-10-31T14:42:42","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"器件设计专家-磁传感器(J10930)","OrgId":2930921,"Org":"设计一部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["上海市","广东省·深圳市","北京市"],"Salary":"面议","Duty":"1.  **器件设计与仿真**：\n    *  进行霍尔器件的结构设计（例如，水平式、垂直式等）。\n    *  熟练使用TCAD，COMSOL等仿真工具，对器件的电学特性、磁电转换特性、应力敏感性等进行建模和仿真，预测并优化其性能。\n\n2.  **工艺开发与整合**：\n    *   与工艺工程师紧密合作，制定和优化霍尔器件的制造工艺流程（如光刻、离子注入、薄膜沉积、刻蚀等）。\n    *   负责将霍尔器件与CMOS标准工艺进行整合，解决集成过程中的技术挑战。\n\n3.  **性能表征与优化**：\n    *   主导芯片样片的测试和数据分析，评估其关键参数：如灵敏度、失调电压、温漂、噪声、非线性度、带宽等。\n    *   基于测试数据，建立精确的器件模型，并反馈至设计端，驱动设计迭代和工艺改进。\n    *   设计和执行器件的可靠性测试，分析失效模式，确保器件满足严格的可靠性标准（尤其是在汽车电子领域）。\n\n4.  **技术文档与支持**：\n    *   撰写详细的设计文档、测试报告和技术规范。\n    *   为产品工程师和应用工程师提供高级技术支持，协助解决量产和客户端出现的与器件物理相关的问题。","Require":"1.  **学历与专业**：\n    *   硕士以上学历，微电子学、半导体物理、电子科学与技术、材料科学等相关专业。\n\n2.  **知识基础**：\n    *   **必需**：扎实的半导体物理和半导体器件知识，深刻理解载流子输运、霍尔效应、磁阻效应等物理机理。\n    *   **必需**：熟悉CMOS制造工艺及流程。\n\n3.  **技术技能**：\n    *   **必需**：熟练使用至少一种TCAD工具（如Sentaurus, Silvaco）进行器件仿真，熟练使用COMSOL进行磁场仿真。\n    *   **必需**：具备丰富的芯片级测试和数据分析经验，熟练使用探针台、半导体参数分析仪、示波器等设备。\n    *   熟悉SPICE模型提取者优先。\n    *   了解磁阻式传感器（如TMR， GMR）技术者优先。\n\n4.  **经验背景**：\n    *   要求3-8年及以上在半导体公司或研究机构从事传感器器件开发或先进半导体器件研发的经验。\n    *   有成功将霍尔器件从设计推向量产的经验者尤佳。\n\n5.  **个人素质**：\n    *   具备强大的动手能力、数据分析能力和问题解决能力。\n    *   严谨的科学态度，对技术细节有极致追求。\n    *   优秀的团队协作和沟通能力。","ClassificationOne":"研发类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-10-31T14:42:42","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"89b4b98c-a07c-43b3-98ba-b5dd5b28b82b","HeadCount":0,"JobAdId":311030364,"PostDateInt":1753866002000,"PostDate":"2025-07-30T17:00:02","EndTimeInt":0,"EndTime":"0001-01-0