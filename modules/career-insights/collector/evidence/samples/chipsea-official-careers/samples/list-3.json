tDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"44b74084-92a8-4130-9ba8-637b092569e1","HeadCount":0,"JobAdId":311157002,"PostDateInt":1782975356000,"PostDate":"2026-07-02T14:55:56","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"IPMT  COO(J10732)","OrgId":4006333,"Org":"质量运营部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市·南山区"],"Salary":"30K-50K 元/月","Duty":"【核心岗位职责】\n①　战略与绩效解码：协助制定部门业务计划（BP），指导二级部门完成战略解码与BP输出；监控财经与HR领域的预算执行及组织绩效达成情况。\n②　资源与人才统筹：协同HRBP实施基于产品优先级的资源管道管理；定期评估人才结构合理性并推动优化；作为职能部门AT成员，参与薪酬、考核与绩效管理。\n③　经营分析与改善：主导月度经营分析，分析业务差距（GAP）并识别根因，提出流程及组织运作改善方案，监控问题闭环。\n④　项目与KPI管控：监控项目执行进度与成本，跟踪并确保一级/二级部门组织KPI及重点工作的执行与闭环管理。\n⑤　体系变革与落地：作为核心力量推动流程与管理体系变革的规划与实施，确保本领域流程及质量体系有效落地，提升运作效率与客户满意度。\n⑥　流程优化与评估：组织流程Owner开展流程优化（涵盖计划、推进与成效监控），并协助考核评估子流程Owner的建设完成情况。\n⑦　DCP全流程运作：统筹IPMT决策检查点（DCP）全流程，确保材料输出与决策过程的规范性（预审→审计→决策→执行闭环）。\n⑧　决策质量与审计：组织评审SP/BP材料以确保战略一致性；持续优化IPMT运作，保障会议质量与决策效率；定期组织质量运营审计，推动系统性问题解决。\n⑨　专业能力赋能：负责本领域项目经理及PQA（产品质量保证）交付能力的建设与提升。\n\n","Require":"【任职资格】\n①　本科及以上学历，微电子、电子工程、计算机科学、通信工程等相关专业\n②　5年以上半导体/芯片行业经验，3年以上芯片项目管理或质量管理经验\n③　完整参与过至少2个芯片项目全生命周期（从定义到量产）\n④　硕士/MBA优先，具备技术+管理的复合背景更佳。\n⑤　有MCU,SOC,专用IC复杂芯片项目管理经验者优先。\n⑥　熟悉IPD管理体系，并有相关流程或数字化变革项目经验者优先。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-07-02T14:55:56","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"85df120d-31ff-41d8-ac5e-f6d4ec8f10c0","HeadCount":0,"JobAdId":311153454,"PostDateInt":1782197530000,"PostDate":"2026-06-23T14:52:10","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"BD经理(J10728)","OrgId":4004929,"Org":"BD市场部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市·南山区"],"Salary":"30K-50K 元/月","Duty":"岗位职责：\n1.面向公司重点行业及战略客户，开展芯片市场机会洞察、客户需求挖掘、竞争格局分析和业务机会判断，输出重点客户、重点项目及重点产品机会清单。\n2.能独立完成客户拜访、技术交流、方案推广、商务谈判及重点项目推进，协同行销、产品线、FAE及研发团队，推动从客户线索、需求澄清、方案导入到项目落地的全过程管理。\n3.围绕汽车、工业、消费电子、能源、机器人、服务器及数据中心等重点应用方向，梳理芯片应用场景、客户痛点和潜在商业模式，推动新客户、新市场突破。\n4.跟踪国内外芯片厂商、竞品动态、重点客户导入状态、价格策略及市场份额变化，形成竞争分析、客户分析和市场策略建议，为公司产品规划和销售策略提供决策支持。\n5.参与主导行业展会、客户峰会、产品发布、生态合作及市场推广活动，提升公司在目标市场和重点客户中的品牌影响力与业务触达能力。\n6.根据市场机会和客户反馈，协同产品线推动新产品定义、产品组合优化、价格体系建设及重点客户定制化合作方案落地。","Require":"任职条件：\n1.本科及以上学历，电子、通信、自动化、市场营销等相关专业优先。\n2.具备5年以上芯片、半导体、电子元器件、硬件方案或相关产业链工作经验；有半导体原厂、代理商经验者优先。\n3.产品背景不限，熟悉MCU、SoC、AFE、ADC、BMS、传感器、接口芯片、电源芯片、驱动芯片、存储芯片、通信芯片等任一芯片品类均可。\n4.熟悉芯片从客户需求挖掘、产品选型、Design-in到量产导入的基本流程，具备较强的客户理解能力和项目推进能力。\n5.具备良好的市场敏感度、商业判断力和竞争分析能力，能够从客户需求和产业趋势中识别业务机会。\n6.具备较强的跨部门协同能力，能够推动销售、产品、研发、FAE、供应链等团队共同完成客户导入和项目落地。\n7.具备良好的沟通表达、商务谈判、材料撰写和客户汇报能力，能够独立完成客户交流、市场分析和业务方案输出。\n8.责任心强，结果导向，具备较强的自驱力、执行力和抗压能力，能够适应一定频率的客户拜访和出差。\n加分项：\n1.有大客户BD、重点行业拓展、生态合作、产品定义或新市场从0到1突破经验者优先。有半导体原厂经历和国际大厂经历优先考虑。\n2.有汽车电子、工业控制、机器人、服务器及数据中心、新能源、消费电子等行业客户资源者优先。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-23T14:52:10","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"c8d3ddf1-2c6a-4ca3-b470-1462bc492bae","HeadCount":0,"JobAdId":311150446,"PostDateInt":1781171485000,"PostDate":"2026-06-11T17:51:25","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"AI智能体应用专家(J10723)","OrgId":2837092,"Org":"康柚健康","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市·南山区"],"Salary":"30K-50K 元/月","Duty":"1、负责健康APP医疗AI智能体架构设计、研发与落地部署，搭建高稳定、轻量化的医疗AI底层服务体系，支撑C端健康、慢病管理业务。\n2、基于大模型微调、Prompt工程、RAG检索技术，搭建并迭代垂直医疗知识库，解决模型幻觉、专业度不足、回答不准等核心问题，保障医疗内容严谨性。\n3、深度拆解互联网医疗、慢病管理业务场景需求，迭代AI智能体核心能力，输出标准化、可复用的医疗AI算法功能模块。\n4、搭建医疗AI模型迭代、内容审核全流程风控机制，严格落地医疗监管、数据安全与隐私合规要求，规避产品合规风险。\n5、跟进医疗大模型、多模态AI前沿技术，沉淀医疗垂域算法落地方法论与研发规范，推动技术标准化复用。\n6、联动产品、研发、医学、业务团队协同推进项目落地，持续优化模型准确率、响应速度，提升用户健康服务体验。","Require":"1、本科及以上学历，计算机、人工智能、生物医学工程等相关专业，3年以上医疗大模型微调、RAG、提示词工程实战落地经验。\n2、熟练掌握PyTorch/TensorFlow等主流框架，精通医疗垂域RAG知识库搭建与优化，可独立解决模型幻觉、领域精准度低、知识时效性差等问题。\n3、具备完整的医疗AI项目闭环落地经验，擅长对接业务、拆解需求，可独立推进算法迭代、跨部门落地上线。\n4、熟悉医疗数据处理规范，具备严谨的技术思维，能平衡模型效果、业务体验与合规要求。\n\n加分项\n1、有健康APP、慢病管理、互联网医疗C端AI项目落地经验；\n2、熟悉医疗行业监管政策、数据安全及隐私合规，参与过医疗AI风控、合规体系搭建；\n3、具备小型算法团队带队经验，可独立沉淀垂域技术方法论、搭建团队研发规范。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-06-11T17:51:25","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"8cb33b14-75c5-4c5a-a30a-