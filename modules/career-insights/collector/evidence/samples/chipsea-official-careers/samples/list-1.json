tion3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-11-10T14:13:17","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"d30e522c-7397-42dc-97cf-ca270088c2bb","HeadCount":0,"JobAdId":311199819,"PostDateInt":1793787670000,"PostDate":"2026-11-04T18:21:10","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"嵌入式应用工程师（授时）(J10800)","OrgId":4006515,"Org":"方案软件1部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"20K-35K 元/月","Duty":"岗位职责:  \n1. 根据项目需求，完成嵌入式应用系统的方案设计与开发工作；  \n2. 负责嵌入式软件的编写、调试及优化，确保系统稳定运行；  \n3. 参与软硬件联调，解决开发过程中的技术问题；  \n4. 编写相关技术文档，支持产品迭代与维护；","Require":"任职要求：  \n1. 熟悉常用嵌入式处理器架构及相关开发调试工具；  \n2. 掌握C/C++等编程语言，具备良好的代码规范；  \n3. 熟悉ADC、SPI、I2C等常用外设接口协议和使用方法；  \n4. 具备较强的逻辑思维和问题分析能力；  \n5. 具有良好的团队合作精神，能够承担工作压力和挑战。\n6. 有can、ethernet接口开发经验者优先；\n7. 有FreeRTOS、Liteos等操作系统适配和应用