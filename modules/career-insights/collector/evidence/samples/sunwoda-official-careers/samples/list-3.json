RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"d687455a-4b58-42e3-9f7d-b295b104c2f9","HeadCount":0,"JobAdId":351590469,"PostDateInt":1785314076000,"PostDate":"2026-07-29T16:34:36","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"安全极片主任工程师/经理2026","OrgId":3207919,"Org":"研发系统","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·惠州市"],"Salary":"面议","Duty":"职责描述：\n‌1、安全技术研发‌：主导安全底涂、表涂等机械安全技术的开发与验证，优化涂层配方以提升极片的抗穿刺性和热稳定性，解决量产中的界面接触问题。\n‌2、可制造性评估‌：制定工艺标准及控制计划，评估新技术的量产适配性，通过实验设计优化参数，确保涂层均匀性和生产效率。\n‌3、量产支持与问题解决‌：统筹量产产品的工艺异常处理，进行失效模式分析，输出有效控制措施；与生产团队协作，确保工艺稳定性和一致性。\n‌4、技术趋势跟踪‌：监测行业动态和竞品技术，结合公司战略建议研发方向，主导技术交流活动，引入前沿涂层方法如静电喷涂。\n‌5、团队协作与知识沉淀‌：领导研发团队，搭建高效管理体系，指导成员专业能力提升；建立工艺数据库，促进标准化和知识传承。\n","Require":"任职要求：\n1、教育背景‌：硕士及以上学历，材料、高分子、化学相关专业优先，博士优先；\n2、经验要求‌：5年以上机械安全技术研发经验，3年以上LCO/NCM安全底涂、表涂开发经验。\n3、技术能力‌：精通极片层级解决机械安全的机理和方向。精通极片涂布工艺及涂层技术，熟悉安全底涂和表涂的配方设计、制备及性能测试。\n4、团队管理：具备良好的组内沟通协调能力，可独立带团队；\n5、创新&攻坚能力：具备较好的创新思维和复杂问题攻关能力，较强的FA分析能力。","ClassificationOne":"电芯研发","ClassificationTwo":"锂威","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-07-29T16:34:36","JobVideoJd":null,"IsAllowRepeatDeliverS