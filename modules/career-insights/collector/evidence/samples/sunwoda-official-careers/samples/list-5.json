ashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"179cc3fe-a18f-4fd7-8f6b-bad11ed4a39c","HeadCount":0,"JobAdId":351572598,"PostDateInt":1780395635000,"PostDate":"2026-06-02T18:20:35","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"BMS软件工程师-能源科技","OrgId":532124,"Org":"能源科技公司","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"【BMS/嵌入式软件工程师~资深工程师】\n岗位职责：\n1、负责嵌入式平台的搭建、调试与部署，保障系统稳定性与性能指标达成；\n2、负责CAN、RS485等工业通信协议的开发、集成与现场调试；\n3、开展U盘/SD卡等嵌入式存储设备的驱动开发、文件系统优化及数据读写性能调优；\n4、实现TCP/IP网络通信功能开发，熟练应用SNMP、MQTT等物联网通信协议；\n5、承担工厂单板级生产控制功能的软件开发与联调测试； \n6、编制完整技术文档，包括系统设计文档、测试报告及用户操作手册；\n7、负责BMS软件开发工作，包括多款模拟前端（AFE）芯片的应用开发、电池管理核心算法设计、充放电控制策略实现，以及SOC/SOH估算等。\n","Require":"1、本科及以上学历，电气工程、控制科学与工程、电力电子、机电一体化、自动化等相关专业；\n2、3年以上BMS/嵌入式软件工作经验；\n3、具备USB协议栈理解能力，有嵌入式USB设备（含U盘类存储设备）驱动或应用开发经验优先；\n4、熟练使用ucos、free rtos、rt-thread等操作系统；\n5、精通CAN、RS485等工业通信协议的开发与故障诊断；\n6、熟悉TCP/IP协议栈原理，具备Socket编程经验及网络通信模块开发能力；\n7、具备模拟前端（AFE）芯片选型、驱动开发及典型应用（如电压/温度采样、均衡控制）经验；\n8、熟悉BMS整体架构，掌握电池管理核心算法及安全机制。","ClassificationOne":"社招","ClassificationTwo":"能源科技","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScor