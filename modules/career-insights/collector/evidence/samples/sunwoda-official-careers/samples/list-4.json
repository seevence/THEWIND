{"Code":200,"Message":"operation success","MoreMessage":"","TipType":"Success","Count":117,"ReturnUrl":null,"Data":[{"Id":"5ce1776f-9e4f-471c-bda1-2a6fea4660ff","HeadCount":0,"JobAdId":351583512,"PostDateInt":1783922382000,"PostDate":"2026-07-13T13:59:42","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"热仿真工程师-能源科技","OrgId":602817,"Org":"网络能源产品线","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"1、负责集装箱式储能、电池柜等整体的热流场设计与仿真分析，运用CFD仿真工具完成热仿真分析及优化设计，并输出专业仿真报告；\n2、对电池包内、柜内、集装箱内的气流组织、温度均匀性、热失控传播风险进行建模与优化，制定高效、可靠的热管理方案；\n3、负责储能热管理关键部件的技术选型与架构定义，热管理系统关键零部件的选型、设计对接与验证工作；\n4、完成热管理相关实验环境搭建、测试执行及数据分析，编写热设计、仿真及测试相关技术文档，协同团队解决热管理问题。","Require":"1、本科及以上学历，能源与动力工程、工程热物理、流体力学等相关专业优先；\n2、3年及以上储能/动力电池热设计/热仿真工作经验；\n3、熟悉电池模组及储能机柜/集装箱的热管理需求与技术特点；\n4、精通至少一款高级CFD仿真软件和一款电子散热仿真软件，具备复杂系统多物理场耦合仿真能力；\n5、具备良好的学习能力、责任心和团队协作能力，能适应快速研发节奏。","ClassificationOne":"社招","ClassificationTwo":"能源科技","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-07-13T13:59:42","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"