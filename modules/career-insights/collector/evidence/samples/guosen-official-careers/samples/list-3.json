ext":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"cb9a8c1d-957e-4905-910e-36778049d409","HeadCount":0,"JobAdId":311142207,"PostDateInt":1779247058000,"PostDate":"2026-05-20T11:17:38","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"金融产品岗(J13957)","OrgId":13038,"Org":"珠海分公司","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·珠海市·香洲区"],"Salary":"面议","Duty":"【岗位职责】\n1.跟踪研究全市场公募、私募、资管及基金投顾产品，构建并维护产品筛选与评价体系。\n2.推动代销产品销售工作及售后服务流程。\n3.对代销及自有金融产品进行跟踪、业绩归因与风险分析，输出产品配置建议。\n4.为前台营销团队提供产品培训、路演支持及客户资产配置报告。","Require":"【任职要求】\n1.本科及以上学历，金融、经济、统计等相关专业。\n2.具备证券从业资格、基金从业资格，通过投资顾问和期货从业资格考试。\n3.具备2年以上金融机构公募/私募产品研究、绩效分析或产品经理岗位经验；或具备2年以上证券、银行等前台营销或客户资产配置经验。\n4.熟悉常见投资策略（多头、量化、CTA、固收+等），能熟练使用Excel或Python进行基础数据分析。\n5.目标感强，主动担当，敢于创新，抗压能力强。","ClassificationOne":"产品类","ClassificationTwo":"珠海分公司","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科","YearsOfWorking":"2年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-05-20T11:17:38","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"5c6ec002-a647-4ace-a6e3-0c7d51e34470","HeadCount":0,"JobAdId":311135396,"PostDateInt":1777367742000,"PostDate":"2026-04-28T17:15:42","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"AI应用算法工程师（Agent与模型优化）(J13947)","OrgId":11908,"Org":"信息技术总部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"1、持续跟踪大模型、Agent和相关金融应用前沿技术发展，结合业务需求推动应用创新与技术方案优化；\n2、深入理解证券业务场景，识别财富管理、投研、投资、投行、风控及内部运营等方向的AI 应用机会，结合业务场景进行问题定义和方案设计，推动通用大模型、小模型及规则策略协同落地，推进投研辅助、文档生成、合规审核、运营提效等应用场景落地建设；\n3、负责基于大模型的Agent应用方案设计与实施，包括工作流编排、工具调用、Prompt 设计、企业知识库（RAG）构建、多系统集成与业务闭环设计；\n4、负责AI模型在特定任务场景中的数据构建、训练/微调、评测验证与迭代优化，提升模型在垂直场景中的准确性、稳定性与可控性；\n5、建立应用效果评测与监控机制，围绕任务成功率、模型准确率/召回率、幻觉控制、用户体验及业务收益等目标指标持续优化。","Require":"1、硕士及以上学历，计算机、人工智能、数学/统计、金融工程等相关专业优先，具有大型金融企业，互联网等企业的AI应用相关工作经验；\n2、掌握机器学习、深度学习等算法理论基础，熟悉主流大模型算法原理、RAG、Agent 等相关技术原理；\n3、具备深入和完整的 AI 应用建模和落地经验，包括需求分析、方案设计、模型优化和评测与服务部署等关键环节；\n4、熟练使用 Python、SQL，熟悉主流模型训练、微调与应用部署技术栈（如PyTorch、LlamaFactory、vLLM），熟悉至少一种主流 Agent / Workflow 编排或开发平台框架（如Dify、LangGraph）；具备良好的工程实现能力与编码能力，熟悉主流 AI 编程工具或个人助手（如 Claude Code、Codex、OpenClaw）。","ClassificationOne":"信息技术类","ClassificationTwo":"信息技术总部","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"硕士研究生","YearsOfWorking":"3年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode"