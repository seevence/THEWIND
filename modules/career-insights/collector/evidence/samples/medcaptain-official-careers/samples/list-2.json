{"Code":200,"Message":"operation success","MoreMessage":"","TipType":"Success","Count":35,"ReturnUrl":null,"Data":[{"Id":"eeeedc70-2c44-41cb-a550-b0fdbbe4055f","HeadCount":0,"JobAdId":190528166,"PostDateInt":1790598672280,"PostDate":"2026-09-28T20:31:12.2804228","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"技术支持工程师(J10108)","OrgId":465573,"Org":"技术支持服务部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["广东省·深圳市"],"Salary":"面议","Duty":"1、负责产品售后服务策略、服务规范流程等的制定、实施及监督；\n2、负责产品质量跟踪、收集客户需求，推动产品改善，识别改善方案对服务的影响，主动沟通争取优选方案；\n3、负责输出多形式的产品技术资料、培训资料等相关文档；\n4、负责培训国内外用户服务工程师，并对其日常业务提供技术支持。","Require":"1、本科及以上学历，理工科背景，生物医学工程、医学检验、临床医学优先；\n2、一年以上医疗行业工程师工作经验，有IVD产品相关产品经验的优先；\n3、具备较强的学习能力、抗压能力及团队协助能力，沟通积极主动，有多部门工作经验者优先；\n4、能熟练运用办公软件，有良好的技术文档编写能力；\n5、英语四级以上，听说读写熟练、流利的优先。","ClassificationOne":"营销","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":"2年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"34","ChangeDate":"2026-09-28T20:31:12.2804228","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":fa