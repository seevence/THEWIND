":"学习业务部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["北京市"],"Salary":"面议","Duty":"岗位职责：\n1.负责区域内大客户的商机拓展和销售工作，为目标客户提供产品解决方案，达成个人销售目标。\n2.负责及时、细致、深入挖掘行业客户需求，为客户提供最合适的行业培训解决方案与服务。\n3.积极建设并维护良好、互信的客户关系，挖掘与客户长期深度合作的商业机会。","Require":"职位要求：\n1.本科及以上学历。\n2.5年以上销售工作经验，3年以上to B端销售经验。\n3.热爱销售工作，能承担销售压力，有良好的沟通技巧和商务谈判能力，擅于深挖客户的潜在需求，具有团队合作精神。\n4.有培训/人力资源服务经验优先；\n5.有培训类软件产品/eHR/OA/CRM/协同办公软件/SAAS软件销售经验优先","ClassificationOne":"销售类","ClassificationTwo":"北京分公司","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2025-11-21T11:40:24","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"cac40b28-0f66-4149-b8b4-6d0c0d2cb138","HeadCount":0,"JobAdId":430044460,"PostDateInt":1763531199000,"PostDate":"2025-11-19T13:46:39","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"法务顾问（法务部/北京）(J13578)","OrgId":