深耕苏锡常（苏州、无锡、常州）区域及所属细分行业、具备对应中大型客户资源者优先。\n3. 具备与客户C-level（高管层）及HR部门的高效沟通能力与人际技巧，人际敏感度高，善于建立并维护苏锡常区域长期稳定的大客户合作关系。\n4. 具备优秀的项目推动、跨部门协作能力，结果导向明确，抗压性强，不轻易放弃，能高效统筹“铁三角”小组推进项目落地。\n5. 具备快速学习能力，能快速掌握公司HR SaaS产品及解决方案，有良好的团队合作意识，可在压力下高效开展工作。","ClassificationOne":"销售类","ClassificationTwo":"苏州分公司","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-03-05T17:07:14","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"e3cded7f-26ca-4b24-b695-5deebcef937d","HeadCount":0,"JobAdId":430044664,"PostDateInt":1772699729000,"PostDate":"2026-03-05T16:35:29","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"测评解决方案顾问（苏皖战区/南京/合肥）(J14029)","OrgId":3302585,"Org":"苏皖人才管理SR支持组","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·南京市","安徽省·合肥市"],"Salary":"面议","Duty":"1. 能深入理解客户需求，独立处理和解决客户所提出的问题，并能将解决方案和工作成