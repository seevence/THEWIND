ription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-02T09:46:22","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"983c9b6c-6aca-4703-b8ec-f66406590968","HeadCount":0,"JobAdId":470018147,"PostDateInt":1788245489000,"PostDate":"2026-09-01T14:51:29","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"资深开发工程师(J23542)","OrgId":700542629,"Org":"AIBG.汽车BU.汽车事业部.汽车业务二部-西安","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["陕西省·西安市"],"Salary":"面议","Duty":"负责公司核心业务服务端系统的设计、开发、迭代与优化，基于Java微服务架构搭建高可用、高并发、高性能的业务链路，保障系统稳定性与可扩展性。\n主导大数据相关业务模块开发，运用Spark、SQL等技术构建数据处理、分析与计算链路，支撑业务数据驱动决策，优化数据处理效率与资源占用。\n参与大数据平台的选型、搭建与运维落地，结合业务需求基于Databricks、Snowflake、DataWorks等平台设计数据存储、计算及治理方案，解决实际项目中的技术难题。\n运用Python进行脚本开发、数据爬虫、自动化工具搭建或大数据辅助处理，配合Java微服务与大数据平台形成技术闭环。\n参与技术架构评审、代码评审，主导核心模块的技术方案设计，推动团队技术沉淀与工程效能提升。\n与产品、售前及海外团队（需英语沟通）协同合作，精准理解需求并转化为技术实现，保障项目按时高质量交付。\n持续关注行业前沿技术（微服务、大数据、分布式架构等），并结合业务场景引入合适的技术方案，推动系统迭代升级。","Require":"核心硬性要求\n本科及以上学历，计算机、软件工程、大数据等相关专业，3年及以上服务端开发经验，其中至少1年Java微服务项目实战经验。\n精通Java编程语言，熟练掌握Spring Cloud、Spring Boot微服务框架，理解微服务架构设计原则、服务治理、熔断限流、分布式事务等核心技术。\n熟练掌握Python编程，能独立运用Python完成脚本开发、数据处理或工具搭建，具备与Java系统、大数据平台的协同开发能力。\n精通Spark生态（Spark Core、Spark SQL、Spark Streaming），具备基于Spark的离线/实时数据处理项目经验，能优化数据计算性能。\n精通SQL语言，熟练掌握关系型数据库（MySQL、Pgsql）及分布式数据库/数据仓库的使用，具备复杂SQL查询优化、数据建模能力。\n具备至少一个大数据平台（Databricks/Snowflake/DataWorks）的实际项目落地经验，熟悉平台核心功能、数据集成、任务调度及性能优化。\n具备良好的英语听说读写能力，能流畅与海外团队沟通需求、同步工作进度，可独立阅读英文技术文档并应用于实际开发。\n具备扎实的计算机基础知识，理解分布式系统、高并发、高可用、缓存、消息队列等核心技术，有较强的问题排查与故障解决能力。\n优先条件\n有零售行业（电商、线下零售、新零售）服务端开发或大数据项目经验者优先，熟悉零售行业业务逻辑（商品、订单、库存、用户、营销等）者加分。\n同时具备多个大数据平台（如Databricks+Snowflake）使用经验，或有大数据平台二次开发、定制化改造经验者优先。\n熟悉Kafka、Flink等实时计算组件，具备端到端实时数据链路搭建经验者优先。\n具备云原生（K8s、Docker）、DevOps、CI/CD流程搭建经验，能推动研发效能提升者优先。\n有基于Dify/Langchain AI Agent搭建实战经验者优先","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-01T14:51:29","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"3bcea6ba-9b18-47ec-9c53-67d66cd7a714","HeadCount":0,"JobAdId":470018139,"PostDateInt":1788173776000,"PostDate":"2026-08-31T18:56:16","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"高级应用开发工程师(J23537)","OrgId":700551211,"Org":"政企BG.能力中心.行业大数据部-成都","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["四川省·成都市"],"Salary":"面议","Duty":"1、参与业务系统模块开发，包括后端接口、数据表设计、接口联调和基础页面开发。\n2、基于 Java/Spring Boot 或 Python 完成业务功能、工具脚本、数据处理或 AI 应用辅助模块。\n3、协助完成 Vue/React 页