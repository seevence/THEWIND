tation":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-08-14T14:03:56","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"dab956ad-f2ce-4edc-8e92-d769f52b128a","HeadCount":0,"JobAdId":470018011,"PostDateInt":1786527986000,"PostDate":"2026-08-12T17:46:26","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"行研专家(J23409)","OrgId":700384696,"Org":"EBG.智算系统BU.NV事业部.销售部-上海","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["上海市"],"Salary":"面议","Duty":"岗位核心定位\n聚焦机器人行业（含工业机器人、人形机器人、服务机器人等细分领域），依托券商行研从业经验，以外部独立视角开展行业研究、趋势研判、标的分析等工作，弥补内部研究视角短板，为公司战略决策、投资布局、业务拓展提供专业、客观的研究支撑。\n\n核心工作职责\n1. 行业深度研究：跟踪机器人行业政策导向、技术迭代、市场规模、竞争格局等核心维度，定期输出行业深度研究报告，精准把握行业发展趋势与投资机会，结合2026年行业量产元年等关键节点，研判产业落地节奏与市场变化。\n2. 标的分析与研判：针对机器人行业上下游核心企业（含上市公司、独角兽企业）开展调研分析，梳理企业核心竞争力、商业模式、财务表现、成长潜力，形成标的分析报告，为投资决策、合作筛选提供依据。\n3. 外部视角输出：跳出内部业务视角，以客观、独立的券商行研思维，针对公司业务布局、战略规划提出外部参考建议，规避行业风险，挖掘潜在合作与投资机会。\n4. 行业资源联动：依托券商从业积累的行业资源，对接机器人行业专家、企业高管、投资机构等，搭建行业交流桥梁，及时获取一手行业信息与前沿动态。\n5. 专项研究支持：配合公司战略、投资等部门，开展机器人行业专项课题研究（如细分赛道潜力分析、产业链供应链优化、竞品对标分析等），按需提供研究成果解读与汇报。","Require":"\n1. 90后，本科及以上学历\n2. 具备券商行研从业经验，有机器人行业或高端制造行业研究经历优先。\n3. 具备扎实的行业研究能力；熟悉机器人行业产业链、核心技术及细分赛道发展现状；具备较强的数据分析、逻辑研判与信息整合能力。\n4. 对机器人行业有浓厚兴趣，持续关注行业前沿动态，具备较强的学习能力与行业敏感度。\n5. 具备独立思考能力，能以外部视角客观分析行业与企业，不局限于固有思维，敢于提出不同观点。\n6.工作积极主动，具备较强的责任心与抗压能力，能高效完成研究任务并按时输出成果。\n7.具备良好的沟通表达能力与团队协作意识，能清晰解读研究成果，配合内部团队推进相关工作。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-08-12T17:46:26","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"e12f48dc-8726-454d-ac5c-ecf71a21fd7f","HeadCount":0,"JobAdId":470017998,"PostDateInt":1786427574000,"PostDate":"2026-08-11T13:52:54","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"编辑(J23397)","OrgId":700380233,"Org"