d":"07796b3b-22f1-41df-8d53-94bca5dbfdfc","HeadCount":0,"JobAdId":151263850,"PostDateInt":1792114151000,"PostDate":"2026-10-16T09:29:11","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"装配技术员","OrgId":1704615,"Org":"南京3厂（秦淮河工厂）","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·南京市·江宁区"],"Salary":"面议","Duty":"1、根据接线图和SOP进行产品器件的装配和配线\n2、进行新产品的装配试制，提交试制问题\n3、完成主管安排的其他任务","Require":"1、35岁以下，大专及以上学历；\n2、具有电气产品的配线及装配经验；能看懂装配图和接线图；\n3、具有较好的质量控制意识；\n4、能熟练使用装配的各种工具；\n5、工作责任心强，吃苦耐劳，服从工作安排","ClassificationOne":"供应链类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"大专","YearsOfWorking":"2年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-16T09:29:11","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"5da1695c-5622-41de-b1b3-f6e3df06baba","HeadCount":0,"JobAdId":151259670,"PostDateInt":1790735527000,"PostDate":"2026-09-30T10:32:07","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"制造工艺工程师（测试）","OrgId":1704612,"Org":"模块工艺工程部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·南京市·江宁区"],"Salary":"面议","Duty":"1. 生产测试\n测试系统开发与维护： 参与或负责搭建、调试和维护充电模块的自动化测试系统（ATE），包括老化测试柜、FCT测试等。\n制定测试规范： 依据产品规格书和行业标准，制定详细的生产测试流程（SOP）和检验标准。\n执行关键测试： 深入理解充电模块的测试关键点，并监督或执行测试，包括但不限于：电气性能测试、安规测试、可靠性测试、功能与通讯测试等。\n数据分析与监控： 对生产测试数据进行统计和分析（如使用SPC工具），监控生产过程的稳定性和产品直通率（FPY），及时发现异常趋势。\n推动良率提升： 与生产、工艺团队合作，分析测试不良品，定位是物料、工艺还是设计问题，并推动改进，提升生产良率和效率。\n2. 失效分析与问题解决\n失效品处理： 接收并管理生产线不良品，进行现象复现和初步诊断，使用一系列工具（显微镜、示波器、热成像仪、功率分析仪、电子负载、X-Ray等）和方法对失效模块进行拆解和根因分析。\n电路分析与维修： 结合原理图，进行点位测量，分析驱动波形、采样电路等，定位故障IC或外围电路，分析根本原因并对失效模块进行维修。\n报告与改进： 撰写专业的失效分析报告，向研发、工艺等部门提供明确的分析结论和改进建议，并跟踪措施的有效性。\n3. 跨部门协作与持续改进\n与研发部门协作，反馈量产中发现的设计问题，参与新产品的设计评审和试产（NPI）导入。\n与工艺、生产部门协作，优化焊接参数、装配工艺等，防止批量性问题的发生。\n与质量、采购部门协作，对供应商来料质量进行评估和失效分析，推动供应商质量改善。","Require":"专科及以上学历，电力电子、电气工程、自动化、微电子等相关专业。\n丰富的动手操作经验，能熟练使用示波器、功率分析仪、电子负载、热像仪、X-Ray等测试工具。\n有自动化测试线体开发或维护经验者优先。\n深刻掌握电路图，理解电力电子元器件（功率半导体、磁芯、电容等）的特性、应用和失效机理经验者优先。\n逻辑清晰，能够从大量测试数据中提炼有价值的信息，发现潜在问题，定位根本原因。\n对产品质量有极高的责任感，失效分析工作繁琐，需要极大的耐心和细致的观察力。\n能够与技术、生产、质量等多个部门有效沟通，推动问题解决。\n熟练掌握Office办公软件，完成失效分析报告。\n适应白夜班工作模式。","ClassificationOne":"供应链类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"大专","YearsOfWorking":"5年","WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Ch