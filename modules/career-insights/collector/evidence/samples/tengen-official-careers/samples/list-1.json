epeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"d7ca5f9a-85a2-4325-88c8-f5c3aef75e58","HeadCount":0,"JobAdId":311202582,"PostDateInt":1794815743000,"PostDate":"2026-11-16T15:55:43","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"技术总工/首席技术专家（低压电器方向）(J13756)","OrgId":0,"Org":"默认部门","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["浙江省·嘉兴市/温州市"],"Salary":"面议","Duty":"1、技术战略与决策：\n\n参与制定公司技术发展战略与产品规划，负责关键技术评审与重大技术决策。\n\n建立并主导公司级技术风险识别、评估与管控体系，确保研发与产品化过程中的技术可靠性。\n\n2、研发体系与质量管控：\n\n主导优化及重构产品研发流程与管理体系，提升研发效率、质量与成功率。\n\n负责核心技术文件、设计图纸、技术标准的最终审核与批准，确保输出质量与合规性。\n\n3、技术攻关与创新引领：\n\n领导公司级专项技术课题、前瞻性基础研究与核心技术攻关项目。\n\n跟踪并洞察低压电器、智能配电、系统解决方案等领域的技术趋势，规划技术预研与储备。\n\n4、团队赋能与知识沉淀\n\n负责技术人才梯队建设，通过导师带教、专业培训及能力模型搭建，系统提升团队技术实力。\n\n主导研发课程体系开发，组织内部专题技术分享，推动知识沉淀与文化传承。","Require":"1、经验背景：\n\n本科及以上学历，电气工程、自动化、机械电子等相关专业。\n\n10年以上低压电器、输配电设备、智能电气系统等领域技术研发经验，曾担任过公司级技术决策角色，对公司的技术战略有直接贡献优先。\n\n具备从产品概念到量产的全生命周期研发主导经验，有成功构建技术平台或突破重大技术难题的实绩。\n\n2、核心能力：\n\n战略视野： 深刻理解行业技术发展动态与竞争格局，具备将技术趋势转化为公司战略落地的能力。\n\n体系构建： 精通IPD、项目管理等研发管理体系，有能力设计并推行适合公司的流程与制度。\n\n卓越管理： 出色的多项目、多团队协同管理能力，能高效协调资源，把控进度、质量与风险。\n\n3、资源网络：\n\n具备良好的内外部技术资源整合能力，包括：\n\n学术资源： 与高校、科研院所保持技术合作与交流。\n\n产业资源： 熟悉供应链与产业链核心环节，拥有关键元器件、重点行业客户等资源。\n\n人才资源： 在业内拥有个人专业声望与人才人脉网络。\n\n4、优先条件\n\n曾在知名电气企业担任技术决策角色者优先。\n\n对低压电器智能化、数字化、成套系统解决方案有深入理解和实践者优先。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Chann