10-23T18:39:42","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"d2354475-9ba9-49a4-aa8e-761955cdd9ed","HeadCount":0,"JobAdId":390875169,"PostDateInt":1792746850000,"PostDate":"2026-10-23T17:14:10","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"安全网关资深技术架构师(J19065)","OrgId":1606584,"Org":"安全产品线","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市","北京市"],"Salary":"面议","Duty":"# 安全网关资深技术架构师（NGFW/威胁引擎方向）\n## 岗位职责\n1. 负责下一代防火墙、边界安全体系的顶层技术规划、架构方案设计、技术路线研判，输出架构白皮书、技术选型规范、大型组网方案，支撑政企/金融/运营商等高等级安全项目落地。\n2. 深度研究NGFW核心能力：报文转发、协议解析、SSL解密、应用识别、IPS、病毒检测、威胁检测引擎、特征引擎、流量归一化、会话管理、硬件卸载（ASIC/FPGA/DPDK）等底层原理，主导引擎方案评估、性能调优、攻防验证、瓶颈定位。\n3. 对标华为、飞塔Fortinet、Palo Alto（PA）、Cisco等主流厂商产品能力差异，完成竞品拆解、技术测评、方案迁移、融合架构设计，输出对比分析报告与优化方案。\n4. 负责高可用、集群、跨中心、多云、SD-WAN、零信任融合场景下防火墙架构设计，解决大流量、低时延、策略规模化管理、日志审计、威胁联动等复杂架构难题。\n5. 主导安全技术预研、技术风险评审、方案评审、攻防测试，沉淀安全架构标准、最佳实践；支撑售前高阶技术交流、技术答辩、重大技术攻关。\n6. 跟踪攻防技术、威胁情报、下一代边界安全技术演进，持续迭代安全防护架构与检测能力。","Require":"任职要求\n1. 本科及以上，计算机、网络、信息安全相关专业，**10年及以上网络安全/防火墙领域技术架构、产品研发或解决方案架构经验**；**优先华为、飞塔、Palo Alto、Cisco、迪普、山石等主流安全厂商背景，从事安全规划、架构研究、NGFW核心引擎相关工作经历**。\n2. 精通TCP/IP协议栈、路由交换（BGP/OSPF/VRRP等）、VPN、NAT、会话机制；**深入理解下一代防火墙架构、深度包检测DPI、威胁检测引擎、特征匹配、IPS/AV、沙箱联动底层实现原理**，能够独立做引擎能力评估、性能压测、根因分析。\n3. 对主流平台有深度实操与架构认知：华为USG、飞塔FortiOS、Palo Alto PANOS、Cisco FTD/ASA、迪普防火墙等，熟悉其集群、HA、集中管理、威胁组件机制，有跨平台迁移、混合组网架构落地经验。\n4. 具备大型数据中心、多分支机构、多云、高并发边界安全架构设计经验，熟悉防火墙性能、并发、会话、吞吐量、时延指标评估体系，懂硬件加速、转发面优化。\n5. 熟悉攻防原理、常见攻击链、威胁情报、ATT&CK框架，理解威胁检测引擎的误报/漏报优化思路；熟悉等保、密评、金融/央国企安全合规要求。\n6. 优秀的方案输出、技术汇报、跨团队技术推动能力，能够独立完成高阶技术交流、技术答辩、复杂问题攻坚；有PCNSE、NSE、HCIE-Security、CCIE等权威安全认证加分。\n7. 加分项：有防火墙引擎、安全固件、DPDK/ASIC转发开发或架构设计经历；大型安全SOC、威胁检测平台联动架构经验。","ClassificationOne":"技术类","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-23T17:14:10","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"fde59945-c130-48a5-8fff-4e73ba58be3a","HeadCount":0,"JobAdId":390871841,"PostDateInt":1791456667000,"PostDate":"2026-10-08T18:51:07","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"政务云云服务拓展专家(J19027)","OrgId":2714364,"Org":"政务系统部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["北京市"],"Salary":"面议","Duty":"岗位职责\n（一）业务拓展支撑\n1、参与全国重点政务云项目的商机研判、业务拓展与方案策划，为一线团队提供业务层面的专业赋能与攻坚支持；\n2、建立云服务业务的标杆案例库与实践，通过案例复制与经验沉淀加速市场拓展；\n3、协调公司内外部资源，保障重点项目的顺利签约、交付与运营，推动项目从单次建设向持续运营服务转化，实现收入模式的升级；\n（二）辅助业务规划与策略制定\n1. 分析目标客户（省/市政府及委办局）的核心痛点与需求变化，制定差异化的市场进入策略与客户拓展计划；\n2. 深入研究政务云云服务市场的发展趋势、竞争格局与政策导向，定期输出行业洞察报告与规划建议，为公司政务云服务业务方向提供决策依据；\n3. 系统梳理云服务商业模式、组织架构与运营机制，明确公司的差异化竞争路径与优势策略；\n4. 了解政务云服务全生命周期（咨询规划 → 迁移交付 → 运维运营 → 持续优化）组织运作，协助设计适配的组织架构与云服务方案体系，明确各环节的职责边界与协同机制（包括但不限于业务拓展、方案需求、运营架构等）。","Require":"任职要求\n（一）学历与经验\n1、全日制本科及以上学历；\n2、5年以上ICT行业工作经验，其中3年以上政务云或云计算服务业务相关经验；\n（二）行业背景   \n1、具备华为、浪潮或中国电信（含天翼云）的政务云服务业务工作经验，深刻理解上述厂商的政务云服务商业模式、组织架构与运营机制；\n2、熟悉政务云市场的竞争格局与运作思路，深度了解政务云发展趋势与客户痛点；\n3、了解政府信息化采购流程、项目运作周期及合规要求，具备与政府客户中高层对话的能力。\n（三）专业能力\n1、精通政务云服务全生命周期管理，包括咨询规划、迁移实施、运维运营等各环节的业务逻辑与关键控制点；\n2、具备服务产品化能力，能将技术能力转化为可标准化、可复制、可商业化的服务产品与解决方案；\n3、具备出色的战略思维与商业洞察力，能将市场趋势转化为可落地的业务策略与行动计划。","ClassificationOne":"营销类","ClassificationTwo":"营销类","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-08T18:51:07","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"7889bd69-29d6-453e-8ec0-205c51fd1f33","HeadCount":0,"JobAdId":390861758,"PostDateInt