rChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-11-12T09:50:03","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"132c5555-88fd-40e3-845f-2e866de7a0b6","HeadCount":0,"JobAdId":561321213,"PostDateInt":1793863661000,"PostDate":"2026-11-05T15:27:41","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"机器视觉工程师（半导体）","OrgId":1616980,"Org":"智能制造","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·无锡市"],"Salary":"面议","Duty":"1、光源与相机选型：根据检测需求独立完成视觉方案设计，负责光源、工业相机、镜头选型与调试，优化成像对比度与精度，沉淀选型规范。\n2、系统搭建与调试：搭建光源+相机+镜头+控制器整体方案，在产线完成成像调试、节拍优化与稳定性验证，处理现场问题。\n3、传统机器视觉算法开发：基于Halcon/OpenCV/海康视觉平台等实现定位、测量、分割、模板匹配、OCR等算法。\n4、AI视觉算法开发：基于PyTorch，按照项目要求训练和部署AI检测模型（分类、检测、分割、异常检测），负责数据集制作、模型训练，模型部署及优化。\n5、C#编程：具有一定的C#语言和WPF界面开发能力，能够开发视觉程序模块供其他程序调用。","Require":"1、本科及以上，自动化/计算机/人工智能等相关专业，2年及以上机器视觉行业经验。\n2、半导体行业视觉经验优先，有AOI检测算法开发经验优先。\n3、具备独立的光源、相机、镜头选型能力，熟悉光学成像原理，线扫，面阵相机原理。\n4、精通Halcon/OpenCV，能独立开发与优化2D视觉算法。有3D视觉经验更佳。\n5、熟悉常用AI视觉模型的训练及部署，包括分类,目标检测,分割等种类的常用模型，例如ResNet,Yolo,U-Net等。\n6、熟悉C#编程，能够编写视觉有关的程序模块。\n7、具有敬业精神、抗压性、良好的团队合作精神，以及较强的逻辑分析和独立解决问题能力。","ClassificationOne":"研发","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"W