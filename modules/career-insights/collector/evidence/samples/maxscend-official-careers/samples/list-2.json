nel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-24T11:40:56","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"19b202c6-8720-41da-b635-e2d376780b68","HeadCount":0,"JobAdId":561309049,"PostDateInt":1790058241000,"PostDate":"2026-09-22T14:24:01","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"品牌内容专员","OrgId":230460,"Org":"证券投资部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·无锡市"],"Salary":"面议","Duty":"/如果你曾经采访过工程师、科学家、企业家，或者写过一篇自己很满意的深度稿，我们很想看看。/\n◆ 理解公司业务\n阅读技术资料、行业报告、财报和管理层观点，与工程师、技术专家和业务负责人交流，快速理解一个陌生领域的基本逻辑。\n◆ 做深度内容\n负责公司对内外平台的技术文章、产业分析、人物访谈、战略解读、专题内容等，从选题、研究、采访到成稿独立完成。\n◆ 采访人物与专家\n理解人物为什么这么判断、这个判断背后的技术和业务逻辑是什么，把专业人士的经验和观点转化成有价值的内容。\n◆ 主动发现选题\n与研发、产品、业务建立长期连接，主动发现值得被外部理解的技术突破、产业变化和公司故事，能与工程师、技术专家和业务负责人建立长期合作。\n◆ 建立内容资产\n持续沉淀技术、产业、人物和战略相关的内容素材，让一次采访、一项技术成果能够在公众号、官网、媒体、展览、客户沟通等不同场景持续复用。","Require":"◆ 本科以上学历，新闻传播、中文、财经、理工科等相关专业优先；\n◆ 有内容、科技媒体、半导体媒体、财经媒体或科技企业内容相关工作经验优先；\n◆ 具备独立采访、资料研究、选题策划和长文写作能力，能够独立完成一篇深度稿件；\n◆ 能够快速理解技术资料、行业报告、财报或管理层讲话，并提炼核心逻辑；\n◆ 有成熟作品集，优先提供深度报道、人物采访、产业分析或技术内容作品；\n◆ 主动使用 AI 等新工具提升信息整理、项目管理和专业工作的效率，并保持持续学习和探索；\n◆ 对科技、工程、产业和人与组织保持好奇，愿意进入陌生领域。\n\n如果你已经是我们正在找的那个“内容大神”，以上要求可以忽略。\n我们更想看看你到底写过什么、想做什么，以及为什么会想来这里？","ClassificationOne":"职能","ClassificationTwo":"卓胜总公司","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"硕士研究生","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-22T14:24:01","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"e8a7ce4a-f0f5-4728-9d4b-38658d858c53","HeadCount":0,"JobAdId":561308748,"PostDateInt":1789997080000,"PostDate":"2026-09-21T21:24:40","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"MEMS声学工程师","OrgId":3253681,"Org":"研发","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·无锡市"],"Salary":"面议","Duty":"负责MEMS MIC芯片设计，包括声学结构、振膜、背极板等核心结构设计，完成器件仿真、参数建模、性能调试与优化；\n负责跟进流片、测试验证，解决研发技术问题，优化产品信噪比、灵敏度等核心参数，迭代升级产品方案。\n负责MEMS MIC封装方案选型、工艺优化及量产跟进，制定封装标准与可靠性测试方案，解决量产良率、气密性、声学失效等问题，平衡产品成本与量产稳定性。\n开展MEMS MIC行业及竞品调研，梳理市场与产品方案，对接终端客户需求，提供技术支持、样品验证与量产对接，跟进客户反馈，推动产品商业化落地与场景拓展。","Require":"任职资格：\n本科及以上学历，微电子、半导体、物理、声学、材料工程等相关专业，熟悉MEMS微机电系统原理、声学器件基础理论。\n精通MEMS MIC芯片设计全流程，熟练使用相关仿真设计工具，具备独立完成芯片结构设计、仿真验证、参数优化的能力，熟悉晶圆流片工艺与测试流程；\n熟练掌握MEMS MIC各类封装工艺，熟悉封装材料、量产设备及可靠性标准，可独立解决封装量产各类技术问题；\n具备扎实的市场研判与客户对接能力，熟悉MEMS MIC行业市场行情、终端应用场景及主流竞品，可独立完成需求拆解、方案定制、技术对接工作；\n掌握MEMS MIC核心性能参数测试与调试方法，熟悉行业相关品质、认证标准。","ClassificationOne":"研发","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"硕士研究生","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-21T21:24:40","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"0d0b76e6-9d0e-4d71-ab8d-184dda26a47b","HeadCount":0,"JobAdId":561308075,"PostDateInt":1789892315000,"PostDate":"2026-09-20T16:18:35","EndTimeInt"