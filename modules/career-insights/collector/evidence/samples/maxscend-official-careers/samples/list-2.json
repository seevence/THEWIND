eliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"e9bea5c1-25af-4021-8494-17396cabb1cb","HeadCount":0,"JobAdId":561310338,"PostDateInt":1790519765000,"PostDate":"2026-09-27T22:36:05","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"文化发展专员","OrgId":230460,"Org":"证券投资部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["江苏省·无锡市"],"Salary":"面议","Duty":"/我们真正关心员工提出的问题，有没有人听见？听见以后，有没有人回应？回应以后，事情有没有真的发生变化？/\n\n◆走进组织，发现文化议题\n深入研发、制造、产品和业务团队，通过访谈、观察、员工交流和项目参与，持续了解员工真实的工作状态、团队关系和组织变化，发现值得关注的文化议题。\n\n◆设计和推动文化项目\n围绕公司文化和组织实际问题，策划价值观对齐、员工参与、文化记忆、团队实践等项目，从议题发现、方案设计到组织推动、复盘评估，独立推进项目落地。\n\n◆沉淀文化实践\n从团队、项目、工程师个人的经历中梳理卓胜微正在形成的工作方式和价值判断，形成文化案例、实践方法和内部资产。\n\n◆建立员工参与机制\n找到不同团队里的文化共创者、故事发现者和实践者，维护持续运转的内部网络。对于涉及组织机制、员工体验和文化议题的问题，与 HR及业务团队协同推进，提出议题并推动文化层面的改变。 \n\n◆运营公司文化发展平台\n围绕工程师的工作、成长、团队实践和真实经历，设计长期栏目、交流和参与机制，让工程师有机会讲述自己，也让更多人理解工程师的工作方式，让更多真实的人参与进来，让好的实践被看见和复制","Require":"◆ 本科及以上学历，组织发展、企业管理、新闻传播、社会学、心理学等相关专业优先；\n◆ 2年以上企业文化、员工沟通、组织发展、雇主品牌、社区运营或项目运营相关经验；\n◆ 愿意真正走进业务部门，有独立负责文化项目、员工活动或跨部门项目的经验，不只是执行过活动；\n◆ 具备较强的访谈、沟通和信息整理能力，有基本的内容能力；\n◆ 具备较强的项目管理和跨部门推动能力；\n◆ 对一个组织为什么会发生变化保持持续好奇，愿意观察、提问，也愿意推动事情真正发生改变；\n◆ 主动使用 AI 等新工具提升信息整理、项目管理和专业工作的效率，并保持持续学习和探索；\n◆ 有科技公司、制造业或互联网公司文化相关经验优先。\n\n如果你对一个组织为什么会有各种变化这件事有超出常人的好奇心，并且真心想参与一家公司的文化建设，以上经验要求可以忽略。\n我们不太在意你过去做过多少场活动，我们更想知道你有没有真正发现过什么问题，又有没有真正推动过什么改变？","ClassificationOne":"职能","ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"I