rkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-27T14:26:47","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"780b3332-814c-418a-97b6-9fe96863bf8b","HeadCount":0,"JobAdId":190873358,"PostDateInt":1792998197000,"PostDate":"2026-10-26T15:03:17","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"中级运营管理师(J14782)","OrgId":700407574,"Org":"运作支持部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市"],"Salary":"面议","Duty":"1、完成业务部门基础运营机制的建立，保障日常运营管理机制的落地实施；\n2、完成业务部门基础汇报材料的统筹、编制，并根据领导的要求对材料进行修订、拉通业务部门完成修订；\n3、完成部门专项管理改进/专项活动的过程运营机制的设计、落地和实施，保障专项活动目标的达成；\n4、统筹业务部门效能看板的设计、过程运营、并进行数据预警，推动预警事项后的待办闭环；\n5、跟进业务部门重点任务、事项的推进、保障部门重点任务的达成 ","Require":"1、 本科及以上学历，具备较强的经营管理思维，能够快速理解部门管理思路 ；\n2、 具备财务、项目管理等相关专业知识；\n3、 具备系统思考、发现和解决问题的能力，优秀的组织、计划、协调和推动力；良好的沟通和汇报能力；\n4、 具备良好的逻辑性、数据分析能力和数据敏感性，能够有效应对风险管理 ；\n5、抗压能力强；能适应一定强度的出差；","ClassificationOne":"运营管理序列","ClassificationTwo":"城市军团","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-10-26T15:03:17","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"88876f77-3536-4995-b35a-4d1ff7b77624","HeadCount":0,"JobAdId":190873251,"PostDateInt":1792981051000,"PostDate":"2026-10-26T10:17:31","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"大模型数据产品经理（知识专家）(J14013)","OrgId":700469877,"Org":"政法军团政法研究院","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市"],"Salary":"面议","Duty":"岗位职责\n1. 法律领域数据体系规划与建设。负责法律领域大模型训练数据的顶层设计，制定数据采集策略、清洗标准，与算法人员协作建设大模型的训练数据。\n2. 法律领域大模型评测体系建设。在法律领域为大模型设计评价体系并建设相应的评测数据集，指导模型的优化方向，常见任务场景包括但不限于律师诉讼、法官办案、合同审查、合同起草、案例检索等。\n3. 业界进展追踪与体验。体验和追踪外部优秀友商和模型厂商的产品，分析优劣势。\n\n","Require":"任职要求\n1. 教育背景与专业资质。全日制本科及以上学历，法学相关专业（通过国家统一法律职业资格考试者优先）。\n2. 法律实务经验。2年以上法律实务工作经验（律所执业、企业法务、法院/检察院、法律科技行业工作经历），对法律业务流程及法律人的真实工作逻辑有切身体感。\n3. AI与数据认知能力。对AI技术的迭代和应用有强烈好奇心，在至少1个场景下深入体验过AI工具在法律工作流上的效果并常态使用。有开发AI工具的经验更佳。\n4. 软性素质。有优秀的团队沟通与协作能力，与产品、算法等角色协作推动产品落地；结果导向，面对不确定的任务能拆解目标并分步达成。","ClassificationOne":"资源序列","ClassificationTwo":"政法军团","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":