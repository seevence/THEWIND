annel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-10-16T08:52:54","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"9f570750-dea2-4083-bc5d-eb6bd829d22c","HeadCount":0,"JobAdId":190870763,"PostDateInt":1792028683000,"PostDate":"2026-10-15T09:44:43","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"大模型算法工程师-AI for Science(J14712)","OrgId":700454067,"Org":"AI研究院前沿科学群","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市"],"Salary":"面议","Duty":"1、基于星火大模型基座，从事“人工智能助力科学研究（AI for Science）”的相关工作，进行科研垂直领域的认知大模型和多模态大模型的设计、开发和优化，包括但不限于预训练、SFT、指令微调、RLHF、Prompt工程、模型评估、模型推理等；\n2、参与和负责大模型技术在科学研究场景中的应用，构建科研专用领域无监督和有监督数据集，并探索大模型RAG、Agent智能体等技术在科研场景的应用；\n3、探索大模型前沿方向，紧跟国内外优势团队和社区的技术发展，追踪前沿技术，形成系统算法/大模型解决方案，推动科研大模型能力不断提升；\n4、协同跨团队技术和业务同学团队合作，达成技术和业务目标。\n\n","Require":"1、硕士及以上学历，计算机、人工智能等相关专业，2年以上AI行业从业经历，发表过AI顶会论文优先；\n2、对NLP等人工智能领域的最新进展、模型、算法有深刻理解，熟练掌握主流深度学习框架pytorch/tensorflow、大模型训练框架Deepspeed/Megatron-LM等多机多卡方案，有百亿/千亿参数大模型训练调优及落地经验优先；\n3、具有良好的沟通能力和团队合作精神，认真负责，较强的逻辑思维能力，沟通能力较强，责任心强，吃苦耐劳，有强烈的上进心和责任感，能主动积极地面对工作，具备对AI研发及应用落地产业化的强烈热情。","ClassificationOne":"研究算法序列","ClassificationTwo":"核心研发平台","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":true,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":nu