、海洋声学相关项目经验者优先；\n6. 具备良好的沟通协作能力、学习能力和问题分析能力，具备英文论文阅读能力，能够适应研究与落地并重的工作模式，具备较强的责任心和抗压能力。","ClassificationOne":"研究算法序列","ClassificationTwo":"核心研发平台","Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":"全职","Channel4IsHot":true,"Channel4IsLong":true,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":"本科及以上","YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"","ChangeDate":"2026-10-14T17:19:23","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null,"RewardText":null,"IsTop":false,"Cash":0,"CashText":null,"HideCash":false,"Score":0,"ScoreText":null,"HideScore":false,"HrDutyUser":null,"DutyUserId":0,"JobId":0,"RewardImgUrl":null,"RewardAttUrl":null,"RewardAttName":null,"JobAdNameWithoutJobCode":null,"Distance":null},{"Id":"c6b290fe-24b7-46b8-9036-5ab84a84988f","HeadCount":0,"JobAdId":190870005,"PostDateInt":1791857974000,"PostDate":"2026-10-13T10:19:34","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"中级行政综合专员(J14688)","OrgId":700367920,"Org":"运作支持部","Category":"社会招聘","CategoryId":"1","LocId":null,"LocNames":["安徽省·合肥市"],"Salary":"面议","Duty":"1、负责行政团队的日常管理，制定团队目标与分工，提升团队专业能力与执行力； \n2、搭建行政团队工作标准与协作流程，优化跨部门行政服务响应机制，保障团队高效运转；\n3、负责公司整体的空间管理，包括办公场地、物资、设备等资源的规划与调配，保障办公环境安全、舒适、高效； \n4、协调解决行政服务中的突发问题，建立风险预警机制，降低行政事务的运营风险；\n5、以 “热心服务、主动响应” 为原则，对接各部门行政需求，